---
import BearagnosticPage from '../../../components/BearagnosticPage.astro';
import { defaultLocale, localeCodes, type LocaleCode } from '../../../i18n/content';

export function getStaticPaths() {
  return localeCodes
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: LocaleCode };
---
<BearagnosticPage locale={locale} />
