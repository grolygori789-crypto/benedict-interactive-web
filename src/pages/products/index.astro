---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/site';
---

<SiteLayout
  title="Products"
  description="Products and platforms from Benedict Interactive."
>
  <section class="page-hero shell">
    <p class="eyebrow">Products</p>
    <h1>Different jobs. One standard of care.</h1>
    <p>
      Benedict Interactive can grow across utilities, quality tools, and future experiments
      without turning the company into a single-product brand.
    </p>
  </section>

  <section class="section shell">
    <div class="product-grid two-column">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  </section>

  <section class="section shell" id="test-center">
    <div class="content-card">
      <p class="eyebrow">Platform direction</p>
      <h2>Benedict Test Center</h2>
      <p>
        Planned as a reusable QA and release-evidence platform: project-driven test packs,
        structured responses, device and build traceability, retest history, reward status,
        and evidence-backed summaries.
      </p>
      <p class="muted">
        The Test Center is architecturally separate from the public corporate website because
        authentication, tester data, and backend security have different requirements.
      </p>
    </div>
  </section>
</SiteLayout>
