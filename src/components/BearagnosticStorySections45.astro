const story = copy[locale as keyof typeof copy] ?? copy.en;
---

<article class="feature-story story-chapter story-speed" aria-labelledby="story-speed-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">04</span>
    <h3 id="story-speed-title">{story.speed.title}</h3>
    <p>{locale === 'en' ? story.speed.lead : `${story.speed.lead} ${story.speed.evidenceBody} ${story.speed.note}`}</p>
  </div>

  <div class="feature-story-visual story-visual story-speed-visual">
    <figure class="story-screen story-speed-screen">
      <img
        src="/products/bearagnostic/showcase/section-04-deep-scan-complete.webp"
        alt={story.speed.screenAlt}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-mascot story-speed-mascot" aria-hidden="true">
      <img
        src="/products/bearagnostic/showcase/dr-bear-ultra-fast-scanning.webp"
        alt=""
        width="1254"
        height="1254"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</article>

<article class="feature-story story-chapter story-proof" aria-labelledby="story-proof-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">05</span>
    <h3 id="story-proof-title">{story.proof.title}</h3>
    <p>{story.proof.lead} {story.proof.note}</p>
  </div>

  <div class="feature-story-visual story-visual story-proof-visual">
    <figure class="story-screen story-proof-a">
      <img
        src="/products/bearagnostic/showcase/section-05-exact-duplicates.webp"
        alt={story.proof.labels[0]}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-screen story-proof-b">
      <img
        src="/products/bearagnostic/showcase/section-05-final-review.webp"
        alt={story.proof.labels[1]}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-screen story-proof-c">
      <img
        src="/products/bearagnostic/showcase/section-05-verified-cleanup.webp"
        alt={story.proof.labels[2]}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-mascot story-proof-mascot" aria-hidden="true">
      <img
        src="/products/bearagnostic/showcase/dr-bear-verified-shield.webp"
        alt=""
        width="1254"
        height="1254"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</article>

<style>
  /*
   * Sections 04–05 deliberately inherit the exact typography hierarchy from
   * the production feature system: feature-number -> h3 -> body copy.
   * Only composition and section-specific evidence art are defined here.
   */
  .story-chapter {
    position: relative !important;
    min-height: 650px !important;
    overflow: hidden !important;
    border-color: rgba(28, 91, 153, .082) !important;
    box-shadow:
      0 30px 78px rgba(29, 67, 107, .074),
      inset 0 1px 0 rgba(255,255,255,.97) !important;
  }

  .story-speed {
    grid-template-columns: minmax(570px, 1.2fr) minmax(300px, .8fr) !important;
    gap: clamp(1.4rem, 2.7vw, 2.8rem) !important;
    background:
      radial-gradient(circle at 13% 16%, rgba(44, 177, 232, .12), transparent 23rem),
      radial-gradient(circle at 69% 86%, rgba(72, 116, 244, .065), transparent 22rem),
      linear-gradient(145deg, rgba(255,255,255,.997), rgba(245,251,255,.975)) !important;
  }

  .story-proof {
    grid-template-columns: minmax(300px, .82fr) minmax(570px, 1.18fr) !important;
    gap: clamp(1.4rem, 2.7vw, 2.8rem) !important;
    background:
      radial-gradient(circle at 88% 15%, rgba(92, 92, 214, .10), transparent 23rem),
      radial-gradient(circle at 65% 86%, rgba(61, 188, 145, .075), transparent 22rem),
      linear-gradient(145deg, rgba(255,255,255,.997), rgba(247,249,255,.975)) !important;
  }

  .story-speed .story-copy { order: 2 !important; }
  .story-speed .story-visual { order: 1 !important; }
  .story-proof .story-copy { order: 1 !important; }
  .story-proof .story-visual { order: 2 !important; }

  .story-copy {
    position: relative;
    z-index: 12;
    max-width: 430px !important;
  }

  .story-copy h3 { text-wrap: balance; }

  .story-speed .feature-number {
    color: #0f7fd0 !important;
    border-color: rgba(23,138,211,.10) !important;
    background: rgba(25,151,224,.065) !important;
    box-shadow: 0 8px 20px rgba(21,123,190,.055) !important;
  }

  .story-proof .feature-number {
    color: #635ac9 !important;
    border-color: rgba(98,89,199,.11) !important;
    background: rgba(111,95,215,.065) !important;
    box-shadow: 0 8px 20px rgba(91,82,186,.05) !important;
  }


  .story-visual {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    max-width: 735px !important;
    min-height: 610px !important;
    margin-inline: auto !important;
    overflow: visible !important;
    isolation: isolate !important;
  }

  .story-visual::before {
    position: absolute;
    z-index: -2;
    inset: 4% -2% 0;
    display: block;
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .story-speed-visual::before {
    background:
      radial-gradient(ellipse at 45% 49%,
        rgba(255,255,255,.996) 0 28%,
        rgba(222,245,255,.56) 49%,
        rgba(202,233,252,.20) 68%,
        transparent 80%);
  }

  .story-proof-visual::before {
    background:
      radial-gradient(ellipse at 57% 48%,
        rgba(255,255,255,.996) 0 27%,
        rgba(234,235,255,.54) 48%,
        rgba(214,244,236,.18) 68%,
        transparent 80%);
  }

  .story-visual::after {
    position: absolute;
    z-index: -1;
    inset: auto 5% 0 5%;
    height: 8%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(25,73,116,.13), transparent 70%);
    filter: blur(11px);
    content: "";
    pointer-events: none;
  }

  .story-screen,
  .story-mascot {
    position: absolute;
    margin: 0;
  }

  .story-screen {
    overflow: hidden;
    padding: 6px;
    border: 1px solid rgba(17,59,96,.105);
    border-radius: 31px;
    background: #fff;
    box-shadow:
      0 32px 72px rgba(24,66,107,.145),
      0 9px 24px rgba(24,66,107,.06);
    box-sizing: border-box;
  }

  .story-screen img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
  }

  .story-mascot img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* 04 — one authentic result plus the dedicated speed mascot. */
  .story-speed-screen {
    z-index: 6;
    inset-block-end: 0;
    inset-inline-start: 4%;
    width: min(37%, 260px);
    transform: rotate(-.75deg);
  }

  .story-speed-mascot {
    z-index: 5;
    inset-inline-end: 0;
    inset-block-end: 0;
    width: min(58%, 414px);
    filter: drop-shadow(0 28px 25px rgba(24,66,107,.12));
  }

  /* 05 — supporting choice/review screens lead into the verified result. */
  .story-proof-a {
    z-index: 1;
    inset-block-start: 4%;
    inset-inline-start: 0;
    width: min(24%, 176px);
    transform: rotate(-2.15deg);
    opacity: .91;
  }

  .story-proof-b {
    z-index: 2;
    inset-block-start: 1%;
    inset-inline-start: 20%;
    width: min(24%, 176px);
    transform: rotate(1.65deg);
    opacity: .97;
  }

  .story-proof-c {
    z-index: 7;
    inset-inline-start: 25%;
    inset-block-end: 0;
    width: min(36%, 260px);
    transform: rotate(-.18deg);
    box-shadow:
      0 36px 80px rgba(31,67,108,.16),
      0 10px 27px rgba(31,67,108,.06);
  }

  .story-proof-mascot {
    z-index: 5;
    inset-inline-end: 0;
