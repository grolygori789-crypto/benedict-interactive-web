---
import type { LocaleCode } from '../i18n/content';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;

const copy = {
  en: {
    speedTitle: 'Fast by design. Never padded.',
    speedLead: 'Bearagnostic finishes when the work is done — not when an animation says so. Deep Scan reads the accessible content within the scope you choose, shows what it reviewed, and stops when the work is complete. Scan time varies by device, storage, file layout, and selected scope.',
    speedAlt: 'Privacy-safe Deep Scan completion screen with run-specific values removed.',
    proofTitle: 'Proof, not promises.',
    proofLead: 'Exact duplicates are verified before cleanup. You choose what stays, review the selected extras, and confirm before deletion. Bearagnostic counts space as reclaimed only after Android confirms the selected copies are gone.',
    proofAlt: ['Exact duplicate selection screen with run-specific details removed.','Final deletion review with run-specific values removed.','Verified duplicate cleanup result with run-specific values removed.'],
  },
  th: {
    speedTitle: 'เร็วตั้งแต่การออกแบบ ไม่ถ่วงเวลาให้ดูยุ่ง',
    speedLead: 'Bearagnostic จบงานเมื่อทำเสร็จจริง ไม่ใช่เมื่อแอนิเมชันบอกว่าจบ Deep Scan อ่านข้อมูลที่เข้าถึงได้ภายในขอบเขตที่คุณเลือก แสดงสิ่งที่ตรวจ และหยุดเมื่อการทำงานเสร็จ เวลาสแกนจริงขึ้นอยู่กับอุปกรณ์ พื้นที่จัดเก็บ รูปแบบไฟล์ และขอบเขตที่เลือก',
    speedAlt: 'หน้าผล Deep Scan ที่ซ่อนค่าจากการใช้งานเฉพาะเครื่องเพื่อความเป็นส่วนตัว',
    proofTitle: 'พิสูจน์ให้เห็น ไม่ใช่แค่พูด',
    proofLead: 'ไฟล์ซ้ำแบบตรงกันจะถูกตรวจยืนยันก่อนทำความสะอาด คุณเลือกเองว่าอะไรอยู่ ตรวจทานสำเนาที่เลือก และยืนยันก่อนลบ Bearagnostic จะนับพื้นที่คืนก็ต่อเมื่อ Android ยืนยันว่าไฟล์ที่เลือกหายไปจริง',
    proofAlt: ['หน้าเลือกไฟล์ซ้ำที่ซ่อนรายละเอียดเฉพาะการใช้งาน','หน้าตรวจทานก่อนลบที่ซ่อนค่าจากการใช้งาน','หน้าผลการลบไฟล์ซ้ำที่ยืนยันแล้วและซ่อนค่าจากการใช้งาน'],
  },
  es: {
    speedTitle: 'Rápido por diseño. Sin esperas artificiales.',
    speedLead: 'Bearagnostic termina cuando el trabajo termina, no cuando una animación lo dice. Deep Scan lee el contenido accesible dentro del alcance elegido, muestra lo revisado y se detiene al completar el trabajo. El tiempo varía según el dispositivo, el almacenamiento, la distribución de archivos y el alcance.',
    speedAlt: 'Resultado de Deep Scan con valores específicos de la ejecución ocultos por privacidad.',
    proofTitle: 'Pruebas, no promesas.',
    proofLead: 'Los duplicados exactos se verifican antes de limpiar. Tú decides qué se queda, revisas las copias seleccionadas y confirmas antes de borrar. Bearagnostic solo cuenta espacio recuperado cuando Android confirma que las copias seleccionadas ya no están.',
    proofAlt: ['Selección de duplicados con datos de ejecución ocultos.','Revisión final con valores de ejecución ocultos.','Resultado verificado con valores de ejecución ocultos.'],
  },
  'pt-br': {
    speedTitle: 'Rápido por design. Sem espera artificial.',
    speedLead: 'O Bearagnostic termina quando o trabalho termina — não quando uma animação manda. O Deep Scan lê o conteúdo acessível dentro do escopo escolhido, mostra o que revisou e para ao concluir. O tempo varia conforme aparelho, armazenamento, organização dos arquivos e escopo.',
    speedAlt: 'Resultado do Deep Scan com valores específicos da execução ocultos por privacidade.',
    proofTitle: 'Prova, não promessa.',
    proofLead: 'Duplicatas exatas são verificadas antes da limpeza. Você decide o que fica, revisa as cópias selecionadas e confirma antes de excluir. O Bearagnostic só conta espaço recuperado quando o Android confirma que as cópias selecionadas realmente foram removidas.',
    proofAlt: ['Seleção de duplicatas com dados da execução ocultos.','Revisão final com valores da execução ocultos.','Resultado verificado com valores da execução ocultos.'],
  },
  fr: {
    speedTitle: 'Rapide par conception. Sans attente artificielle.',
    speedLead: 'Bearagnostic s’arrête quand le travail est réellement terminé, pas quand une animation le décide. Deep Scan lit le contenu accessible dans le périmètre choisi, montre ce qui a été examiné et s’arrête une fois le travail fini. La durée varie selon l’appareil, le stockage, l’organisation des fichiers et le périmètre.',
    speedAlt: 'Résultat Deep Scan avec les valeurs propres à l’exécution masquées pour la confidentialité.',
    proofTitle: 'Des preuves, pas des promesses.',
    proofLead: 'Les doublons exacts sont vérifiés avant le nettoyage. Vous choisissez ce qui reste, examinez les copies sélectionnées puis confirmez avant suppression. Bearagnostic ne compte l’espace récupéré qu’après confirmation par Android de la disparition des copies sélectionnées.',
    proofAlt: ['Sélection de doublons avec données d’exécution masquées.','Vérification finale avec valeurs d’exécution masquées.','Résultat vérifié avec valeurs d’exécution masquées.'],
  },
  de: {
    speedTitle: 'Schnell gebaut. Nie künstlich ausgebremst.',
    speedLead: 'Bearagnostic endet, wenn die Arbeit erledigt ist — nicht wenn eine Animation es behauptet. Deep Scan liest zugängliche Inhalte im gewählten Umfang, zeigt die geprüften Inhalte und stoppt nach Abschluss. Die Dauer hängt von Gerät, Speicher, Dateistruktur und gewähltem Umfang ab.',
    speedAlt: 'Deep-Scan-Ergebnis mit aus Datenschutzgründen ausgeblendeten Laufwerten.',
    proofTitle: 'Beweise statt Versprechen.',
    proofLead: 'Exakte Duplikate werden vor der Bereinigung verifiziert. Du entscheidest, was bleibt, prüfst die ausgewählten Kopien und bestätigst vor dem Löschen. Bearagnostic zählt Speicher erst dann als zurückgewonnen, wenn Android bestätigt, dass die ausgewählten Kopien entfernt wurden.',
    proofAlt: ['Duplikatauswahl mit ausgeblendeten Laufdaten.','Letzte Prüfung mit ausgeblendeten Laufwerten.','Verifiziertes Ergebnis mit ausgeblendeten Laufwerten.'],
  },
  it: {
    speedTitle: 'Veloce per progetto. Mai rallentato apposta.',
    speedLead: 'Bearagnostic termina quando il lavoro è davvero finito, non quando lo dice un’animazione. Deep Scan legge il contenuto accessibile nell’ambito scelto, mostra ciò che ha esaminato e si ferma al termine. La durata varia in base a dispositivo, memoria, disposizione dei file e ambito selezionato.',
    speedAlt: 'Risultato Deep Scan con valori della singola esecuzione nascosti per privacy.',
    proofTitle: 'Prove, non promesse.',
    proofLead: 'I duplicati esatti vengono verificati prima della pulizia. Scegli cosa resta, controlli le copie selezionate e confermi prima di eliminare. Bearagnostic conta lo spazio recuperato solo dopo che Android conferma la rimozione delle copie selezionate.',
    proofAlt: ['Selezione duplicati con dati di esecuzione nascosti.','Revisione finale con valori di esecuzione nascosti.','Risultato verificato con valori di esecuzione nascosti.'],
  },
  ja: {
    speedTitle: '速さは設計から。待ち時間を演出しない。',
    speedLead: 'Bearagnostic は、アニメーションではなく実際の処理が終わった時点で完了します。Deep Scan は選択した範囲のアクセス可能な内容を読み、確認した内容を示し、処理完了時に停止します。所要時間は端末、ストレージ、ファイル配置、選択範囲によって変わります。',
    speedAlt: '実行固有の値をプライバシー保護のため非表示にした Deep Scan 完了画面。',
    proofTitle: '約束より、証拠を。',
    proofLead: '完全一致の重複は削除前に検証されます。残すものを自分で選び、選択したコピーを確認してから削除を確定します。Bearagnostic は Android が選択したコピーの削除を確認した後にのみ回収容量として数えます。',
    proofAlt: ['実行固有情報を非表示にした重複選択画面。','実行固有値を非表示にした最終確認画面。','実行固有値を非表示にした検証済み結果画面。'],
  },
  ko: {
    speedTitle: '설계부터 빠르게. 억지 대기는 없이.',
    speedLead: 'Bearagnostic은 애니메이션이 아니라 실제 작업이 끝났을 때 완료됩니다. Deep Scan은 선택한 범위의 접근 가능한 콘텐츠를 읽고 검토한 내용을 보여 준 뒤 작업이 끝나면 멈춥니다. 시간은 기기, 저장장치, 파일 배치, 선택 범위에 따라 달라집니다.',
    speedAlt: '개인정보 보호를 위해 실행별 수치를 숨긴 Deep Scan 완료 화면.',
    proofTitle: '약속보다 증거.',
    proofLead: '완전히 동일한 중복 파일은 정리 전에 검증됩니다. 남길 항목을 직접 선택하고 선택된 복사본을 검토한 뒤 삭제를 확인합니다. Bearagnostic은 Android가 선택된 복사본의 삭제를 확인한 뒤에만 회수 공간으로 계산합니다.',
    proofAlt: ['실행별 정보를 숨긴 중복 선택 화면.','실행별 수치를 숨긴 최종 검토 화면.','실행별 수치를 숨긴 검증 결과 화면.'],
  },
  id: {
    speedTitle: 'Cepat sejak dirancang. Tanpa jeda buatan.',
    speedLead: 'Bearagnostic selesai saat pekerjaannya benar-benar selesai, bukan saat animasi mengatakannya. Deep Scan membaca konten yang dapat diakses dalam cakupan pilihan Anda, menunjukkan apa yang ditinjau, lalu berhenti saat selesai. Waktu pemindaian bergantung pada perangkat, penyimpanan, susunan file, dan cakupan.',
    speedAlt: 'Layar Deep Scan dengan nilai khusus proses disembunyikan demi privasi.',
    proofTitle: 'Bukti, bukan janji.',
    proofLead: 'Duplikat identik diverifikasi sebelum pembersihan. Anda memilih apa yang tetap ada, meninjau salinan terpilih, lalu mengonfirmasi sebelum menghapus. Bearagnostic hanya menghitung ruang sebagai kembali setelah Android mengonfirmasi salinan terpilih benar-benar hilang.',
    proofAlt: ['Layar pemilihan duplikat dengan data proses disembunyikan.','Tinjauan akhir dengan nilai proses disembunyikan.','Hasil terverifikasi dengan nilai proses disembunyikan.'],
  },
  vi: {
    speedTitle: 'Nhanh từ thiết kế. Không kéo dài giả tạo.',
    speedLead: 'Bearagnostic kết thúc khi công việc thực sự hoàn tất, không phải khi hoạt ảnh nói vậy. Deep Scan đọc nội dung có thể truy cập trong phạm vi bạn chọn, cho biết những gì đã kiểm tra và dừng khi hoàn tất. Thời gian quét phụ thuộc vào thiết bị, bộ nhớ, cách bố trí tệp và phạm vi đã chọn.',
    speedAlt: 'Màn hình Deep Scan đã ẩn các giá trị riêng của lần chạy để bảo vệ quyền riêng tư.',
    proofTitle: 'Bằng chứng, không phải lời hứa.',
    proofLead: 'Các bản sao trùng khớp được xác minh trước khi dọn dẹp. Bạn chọn nội dung giữ lại, xem lại các bản sao đã chọn và xác nhận trước khi xóa. Bearagnostic chỉ tính dung lượng thu hồi sau khi Android xác nhận các bản sao đã chọn thực sự biến mất.',
    proofAlt: ['Màn hình chọn tệp trùng đã ẩn dữ liệu lần chạy.','Màn hình xem lại cuối đã ẩn giá trị lần chạy.','Kết quả đã xác minh với giá trị lần chạy được ẩn.'],
  },
  'zh-cn': {
    speedTitle: '快，是设计出来的。绝不虚假拖延。',
    speedLead: 'Bearagnostic 在工作真正完成时结束，而不是等动画说完成。Deep Scan 会读取所选范围内可访问的内容，展示已检查的内容，并在工作完成时停止。扫描时间会因设备、存储、文件布局和所选范围而变化。',
    speedAlt: '为保护隐私而隐藏单次运行数据的 Deep Scan 完成界面。',
    proofTitle: '用证据说话，而不是承诺。',
    proofLead: '完全相同的重复文件会在清理前验证。你决定保留什么、复核所选副本，并在删除前确认。只有 Android 确认所选副本确实已删除后，Bearagnostic 才会计算已回收空间。',
    proofAlt: ['隐藏单次运行信息的重复文件选择界面。','隐藏单次运行数值的最终确认界面。','隐藏单次运行数值的已验证结果界面。'],
  },
  'zh-tw': {
    speedTitle: '快，是設計出來的。絕不虛假拖延。',
    speedLead: 'Bearagnostic 在工作真正完成時結束，而不是等動畫說完成。Deep Scan 會讀取所選範圍內可存取的內容，顯示已檢查的內容，並在工作完成時停止。掃描時間會依裝置、儲存空間、檔案配置與所選範圍而不同。',
    speedAlt: '為保護隱私而隱藏單次執行資料的 Deep Scan 完成畫面。',
    proofTitle: '用證據說話，而不是承諾。',
    proofLead: '完全相同的重複檔案會在清理前驗證。你決定保留什麼、檢查所選副本，並在刪除前確認。只有 Android 確認所選副本確實已移除後，Bearagnostic 才會計算已回收空間。',
    proofAlt: ['隱藏單次執行資訊的重複檔案選擇畫面。','隱藏單次執行數值的最終確認畫面。','隱藏單次執行數值的已驗證結果畫面。'],
  },
  ar: {
    speedTitle: 'سريع بتصميمه. بلا انتظار مصطنع.',
    speedLead: 'ينتهي Bearagnostic عندما ينتهي العمل فعلاً، لا عندما تقول الرسوم المتحركة ذلك. يقرأ Deep Scan المحتوى المتاح ضمن النطاق الذي تختاره، ويعرض ما راجعه، ثم يتوقف عند اكتمال العمل. تختلف مدة الفحص حسب الجهاز والتخزين وتوزيع الملفات والنطاق المختار.',
    speedAlt: 'شاشة اكتمال Deep Scan مع إخفاء قيم التشغيل الخاصة حفاظاً على الخصوصية.',
    proofTitle: 'دليل، لا وعود.',
    proofLead: 'يتم التحقق من النسخ المتطابقة قبل التنظيف. تختار ما يبقى، وتراجع النسخ المحددة، ثم تؤكد قبل الحذف. لا يحتسب Bearagnostic المساحة كمستعادة إلا بعد أن يؤكد Android أن النسخ المحددة قد اختفت فعلاً.',
    proofAlt: ['شاشة اختيار النسخ المكررة مع إخفاء بيانات التشغيل.','مراجعة نهائية مع إخفاء قيم التشغيل.','نتيجة موثقة مع إخفاء قيم التشغيل.'],
  },
  hi: {
    speedTitle: 'डिज़ाइन से तेज़। दिखावटी इंतज़ार नहीं।',
    speedLead: 'Bearagnostic तब समाप्त होता है जब काम सच में पूरा हो जाता है, न कि जब कोई एनीमेशन ऐसा कहे। Deep Scan चुने गए दायरे में उपलब्ध सामग्री पढ़ता है, जो जाँचा गया उसे दिखाता है और काम पूरा होने पर रुकता है। समय डिवाइस, स्टोरेज, फ़ाइल व्यवस्था और चुने गए दायरे पर निर्भर करता है।',
    speedAlt: 'गोपनीयता के लिए रन-विशिष्ट मान हटाए गए Deep Scan परिणाम।',
    proofTitle: 'वादे नहीं, प्रमाण।',
    proofLead: 'सटीक डुप्लिकेट साफ़ करने से पहले सत्यापित किए जाते हैं। आप तय करते हैं क्या रखना है, चुनी गई प्रतियों की समीक्षा करते हैं और हटाने से पहले पुष्टि करते हैं। Bearagnostic जगह को तभी वापस मिली मानता है जब Android पुष्टि करे कि चुनी गई प्रतियाँ वास्तव में हट चुकी हैं।',
    proofAlt: ['रन डेटा हटाकर दिखाया गया डुप्लिकेट चयन।','रन मान हटाकर दिखाया गया अंतिम रिव्यू।','रन मान हटाकर दिखाया गया सत्यापित परिणाम।'],
  },
  tr: {
    speedTitle: 'Tasarım gereği hızlı. Yapay bekleme yok.',
    speedLead: 'Bearagnostic, bir animasyon öyle söylediğinde değil, iş gerçekten bittiğinde tamamlanır. Deep Scan seçtiğiniz kapsam içindeki erişilebilir içeriği okur, neleri incelediğini gösterir ve iş tamamlandığında durur. Süre; cihaz, depolama, dosya düzeni ve seçilen kapsama göre değişir.',
    speedAlt: 'Gizlilik için çalışmaya özel değerleri gizlenmiş Deep Scan sonuç ekranı.',
    proofTitle: 'Söz değil, kanıt.',
    proofLead: 'Birebir kopyalar temizleme öncesinde doğrulanır. Neyin kalacağını siz seçer, seçilen kopyaları gözden geçirir ve silmeden önce onaylarsınız. Bearagnostic, alanı ancak Android seçilen kopyaların gerçekten kaldırıldığını doğruladıktan sonra geri kazanılmış sayar.',
    proofAlt: ['Çalışmaya özel verileri gizlenmiş kopya seçim ekranı.','Çalışmaya özel değerleri gizlenmiş son inceleme.','Çalışmaya özel değerleri gizlenmiş doğrulanmış sonuç.'],
  },
} as const;

const story = copy[locale as keyof typeof copy] ?? copy.en;
---

<article class="feature-story story-chapter story-speed" aria-labelledby="story-speed-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">04</span>
    <h3 id="story-speed-title">{story.speedTitle}</h3>
    <p>{story.speedLead}</p>
  </div>

  <div class="feature-story-visual story-visual story-speed-visual">
    <figure class="story-screen story-speed-screen">
      <img
        src="/products/bearagnostic/showcase/section-04-deep-scan-privacy-safe.webp"
        alt={story.speedAlt}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-mascot story-speed-mascot" aria-hidden="true">
      <img
        src="/products/bearagnostic/showcase/dr-bear-speed-runner.png"
        alt=""
        width="1536"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</article>

<article class="feature-story story-chapter story-proof" aria-labelledby="story-proof-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">05</span>
    <h3 id="story-proof-title">{story.proofTitle}</h3>
    <p>{story.proofLead}</p>
  </div>

  <div class="feature-story-visual story-visual story-proof-visual">
    <figure class="story-screen story-proof-a">
      <img src="/products/bearagnostic/showcase/section-05-exact-duplicates-privacy-safe.webp" alt={story.proofAlt[0]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-screen story-proof-b">
      <img src="/products/bearagnostic/showcase/section-05-final-review-privacy-safe.webp" alt={story.proofAlt[1]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-screen story-proof-c">
      <img src="/products/bearagnostic/showcase/section-05-verified-cleanup-privacy-safe.webp" alt={story.proofAlt[2]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-mascot story-proof-mascot" aria-hidden="true">
      <img src="/products/bearagnostic/showcase/dr-bear-verified-shield-final.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" />
    </figure>
  </div>
</article>

<style>
  /* 04–05 intentionally mirror the production grammar used by 01–03. */
  .story-chapter {
    position: relative !important;
