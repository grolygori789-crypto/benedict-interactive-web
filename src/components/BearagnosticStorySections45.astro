---
import type { LocaleCode } from '../i18n/content';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;

const copy = {
  en: {
    speedTitle: 'Fast by design. Never padded.',
    speedLead: 'Bearagnostic is built to do the work that matters, show what it reviewed, and stop when the task is complete — without padded progress or artificial waiting. Performance varies by device, storage, accessible content, and the task you choose.',
    speedAlt: 'Privacy-safe Deep Scan completion screen with run-specific values removed.',
    proofTitle: 'Proof, not promises.',
    proofLead: 'Bearagnostic keeps cleanup decisions in your hands. You review what will change, confirm before anything is removed, and reclaimed space is counted only after Android confirms the result.',
    proofAlt: ['Exact duplicate selection screen with run-specific details removed.','Final deletion review with run-specific values removed.','Verified duplicate cleanup result with run-specific values removed.'],
  },
  th: {
    speedTitle: 'เร็วตั้งแต่การออกแบบ ไม่ถ่วงเวลาให้ดูยุ่ง',
    speedLead: 'Bearagnostic ถูกออกแบบให้ทำเฉพาะงานที่จำเป็น แสดงสิ่งที่ตรวจ และหยุดเมื่อภารกิจเสร็จจริง โดยไม่ยืดความคืบหน้าหรือสร้างเวลารอเทียม ประสิทธิภาพขึ้นอยู่กับอุปกรณ์ พื้นที่จัดเก็บ เนื้อหาที่เข้าถึงได้ และงานที่คุณเลือก',
    speedAlt: 'หน้าผล Deep Scan ที่ซ่อนค่าจากการใช้งานเฉพาะเครื่องเพื่อความเป็นส่วนตัว',
    proofTitle: 'พิสูจน์ให้เห็น ไม่ใช่แค่พูด',
    proofLead: 'Bearagnostic ให้คุณเป็นผู้ตัดสินใจเรื่องการทำความสะอาด คุณตรวจดูสิ่งที่จะเปลี่ยน ยืนยันก่อนมีการลบ และระบบจะนับพื้นที่คืนเฉพาะหลังจาก Android ยืนยันผลแล้ว',
    proofAlt: ['หน้าเลือกไฟล์ซ้ำที่ซ่อนรายละเอียดเฉพาะการใช้งาน','หน้าตรวจทานก่อนลบที่ซ่อนค่าจากการใช้งาน','หน้าผลการลบไฟล์ซ้ำที่ยืนยันแล้วและซ่อนค่าจากการใช้งาน'],
  },
  es: {
    speedTitle: 'Rápido por diseño. Sin esperas artificiales.',
    speedLead: 'Bearagnostic está diseñado para hacer el trabajo que importa, mostrar lo que revisó y detenerse cuando la tarea termina, sin progreso inflado ni esperas artificiales. El rendimiento varía según el dispositivo, el almacenamiento, el contenido accesible y la tarea elegida.',
    speedAlt: 'Resultado de Deep Scan con valores específicos de la ejecución ocultos por privacidad.',
    proofTitle: 'Pruebas, no promesas.',
    proofLead: 'Bearagnostic mantiene las decisiones de limpieza en tus manos. Revisas qué va a cambiar, confirmas antes de que se elimine nada y el espacio solo se cuenta como recuperado después de que Android confirma el resultado.',
    proofAlt: ['Selección de duplicados con datos de ejecución ocultos.','Revisión final con valores de ejecución ocultos.','Resultado verificado con valores de ejecución ocultos.'],
  },
  'pt-br': {
    speedTitle: 'Rápido por design. Sem espera artificial.',
    speedLead: 'O Bearagnostic foi projetado para fazer o trabalho que importa, mostrar o que revisou e parar quando a tarefa termina — sem progresso artificial nem espera de mentira. O desempenho varia conforme aparelho, armazenamento, conteúdo acessível e a tarefa escolhida.',
    speedAlt: 'Resultado do Deep Scan com valores específicos da execução ocultos por privacidade.',
    proofTitle: 'Prova, não promessa.',
    proofLead: 'O Bearagnostic mantém as decisões de limpeza nas suas mãos. Você revisa o que vai mudar, confirma antes de qualquer remoção e o espaço só é contado como recuperado depois que o Android confirma o resultado.',
    proofAlt: ['Seleção de duplicatas com dados da execução ocultos.','Revisão final com valores da execução ocultos.','Resultado verificado com valores da execução ocultos.'],
  },
  fr: {
    speedTitle: 'Rapide par conception. Sans attente artificielle.',
    speedLead: 'Bearagnostic est conçu pour effectuer le travail utile, montrer ce qui a été examiné et s’arrêter une fois la tâche terminée, sans progression artificiellement prolongée ni attente simulée. Les performances varient selon l’appareil, le stockage, le contenu accessible et la tâche choisie.',
    speedAlt: 'Résultat Deep Scan avec les valeurs propres à l’exécution masquées pour la confidentialité.',
    proofTitle: 'Des preuves, pas des promesses.',
    proofLead: 'Bearagnostic vous laisse la décision du nettoyage. Vous examinez ce qui va changer, confirmez avant toute suppression, et l’espace n’est compté comme récupéré qu’après confirmation du résultat par Android.',
    proofAlt: ['Sélection de doublons avec données d’exécution masquées.','Vérification finale avec valeurs d’exécution masquées.','Résultat vérifié avec valeurs d’exécution masquées.'],
  },
  de: {
    speedTitle: 'Schnell gebaut. Nie künstlich ausgebremst.',
    speedLead: 'Bearagnostic ist darauf ausgelegt, die relevante Arbeit zu erledigen, zu zeigen, was geprüft wurde, und nach Abschluss der Aufgabe zu stoppen — ohne künstlich gestreckten Fortschritt oder vorgetäuschte Wartezeit. Die Leistung hängt von Gerät, Speicher, zugänglichen Inhalten und der gewählten Aufgabe ab.',
    speedAlt: 'Deep-Scan-Ergebnis mit aus Datenschutzgründen ausgeblendeten Laufwerten.',
    proofTitle: 'Beweise statt Versprechen.',
    proofLead: 'Bearagnostic lässt die Entscheidungen zur Bereinigung bei dir. Du prüfst, was sich ändern wird, bestätigst vor jeder Entfernung, und Speicher wird erst dann als zurückgewonnen gezählt, wenn Android das Ergebnis bestätigt.',
    proofAlt: ['Duplikatauswahl mit ausgeblendeten Laufdaten.','Letzte Prüfung mit ausgeblendeten Laufwerten.','Verifiziertes Ergebnis mit ausgeblendeten Laufwerten.'],
  },
  it: {
    speedTitle: 'Veloce per progetto. Mai rallentato apposta.',
    speedLead: 'Bearagnostic è progettato per svolgere il lavoro che conta, mostrare ciò che ha esaminato e fermarsi quando l’attività è completa, senza progressi gonfiati o attese artificiali. Le prestazioni variano in base al dispositivo, alla memoria, ai contenuti accessibili e all’attività scelta.',
    speedAlt: 'Risultato Deep Scan con valori della singola esecuzione nascosti per privacy.',
    proofTitle: 'Prove, non promesse.',
    proofLead: 'Bearagnostic lascia a te le decisioni sulla pulizia. Controlli cosa cambierà, confermi prima che venga rimosso qualsiasi elemento e lo spazio viene contato come recuperato solo dopo che Android conferma il risultato.',
    proofAlt: ['Selezione duplicati con dati di esecuzione nascosti.','Revisione finale con valori di esecuzione nascosti.','Risultato verificato con valori di esecuzione nascosti.'],
  },
  ja: {
    speedTitle: '速さは設計から。待ち時間を演出しない。',
    speedLead: 'Bearagnostic は必要な処理を行い、確認した内容を示し、タスクが完了した時点で停止するよう設計されています。進捗を引き延ばしたり、待ち時間を演出したりしません。性能は端末、ストレージ、アクセス可能な内容、選択したタスクによって変わります。',
    speedAlt: '実行固有の値をプライバシー保護のため非表示にした Deep Scan 完了画面。',
    proofTitle: '約束より、証拠を。',
    proofLead: 'Bearagnostic では、クリーンアップの判断はユーザーが行います。何が変わるかを確認し、削除前に確定し、Android が結果を確認した後にのみ回収容量として計算します。',
    proofAlt: ['実行固有情報を非表示にした重複選択画面。','実行固有値を非表示にした最終確認画面。','実行固有値を非表示にした検証済み結果画面。'],
  },
  ko: {
    speedTitle: '설계부터 빠르게. 억지 대기는 없이.',
    speedLead: 'Bearagnostic은 필요한 작업을 수행하고 검토한 내용을 보여 준 뒤 작업이 완료되면 멈추도록 설계되었습니다. 진행률을 억지로 늘리거나 인위적인 대기 시간을 만들지 않습니다. 성능은 기기, 저장장치, 접근 가능한 콘텐츠, 선택한 작업에 따라 달라집니다.',
    speedAlt: '개인정보 보호를 위해 실행별 수치를 숨긴 Deep Scan 완료 화면.',
    proofTitle: '약속보다 증거.',
    proofLead: 'Bearagnostic은 정리 결정을 사용자가 직접 내리도록 합니다. 무엇이 바뀌는지 검토하고 삭제 전에 확인하며, Android가 결과를 확인한 뒤에만 회수된 공간으로 계산합니다.',
    proofAlt: ['실행별 정보를 숨긴 중복 선택 화면.','실행별 수치를 숨긴 최종 검토 화면.','실행별 수치를 숨긴 검증 결과 화면.'],
  },
  id: {
    speedTitle: 'Cepat sejak dirancang. Tanpa jeda buatan.',
    speedLead: 'Bearagnostic dirancang untuk mengerjakan hal yang penting, menunjukkan apa yang ditinjau, lalu berhenti saat tugas selesai — tanpa progres yang dipanjangkan atau waktu tunggu buatan. Kinerja bergantung pada perangkat, penyimpanan, konten yang dapat diakses, dan tugas yang Anda pilih.',
    speedAlt: 'Layar Deep Scan dengan nilai khusus proses disembunyikan demi privasi.',
    proofTitle: 'Bukti, bukan janji.',
    proofLead: 'Bearagnostic menempatkan keputusan pembersihan di tangan Anda. Anda meninjau apa yang akan berubah, mengonfirmasi sebelum apa pun dihapus, dan ruang baru dihitung kembali setelah Android mengonfirmasi hasilnya.',
    proofAlt: ['Layar pemilihan duplikat dengan data proses disembunyikan.','Tinjauan akhir dengan nilai proses disembunyikan.','Hasil terverifikasi dengan nilai proses disembunyikan.'],
  },
  vi: {
    speedTitle: 'Nhanh từ thiết kế. Không kéo dài giả tạo.',
    speedLead: 'Bearagnostic được thiết kế để làm đúng phần việc cần thiết, cho bạn thấy những gì đã được kiểm tra và dừng khi tác vụ hoàn tất — không kéo dài tiến trình hay tạo thời gian chờ giả. Hiệu suất phụ thuộc vào thiết bị, bộ nhớ, nội dung có thể truy cập và tác vụ bạn chọn.',
    speedAlt: 'Màn hình Deep Scan đã ẩn các giá trị riêng của lần chạy để bảo vệ quyền riêng tư.',
    proofTitle: 'Bằng chứng, không phải lời hứa.',
    proofLead: 'Bearagnostic để quyết định dọn dẹp trong tay bạn. Bạn xem lại những gì sẽ thay đổi, xác nhận trước khi có nội dung bị xóa và dung lượng chỉ được tính là đã thu hồi sau khi Android xác nhận kết quả.',
    proofAlt: ['Màn hình chọn tệp trùng đã ẩn dữ liệu lần chạy.','Màn hình xem lại cuối đã ẩn giá trị lần chạy.','Kết quả đã xác minh với giá trị lần chạy được ẩn.'],
  },
  'zh-cn': {
    speedTitle: '快，是设计出来的。绝不虚假拖延。',
    speedLead: 'Bearagnostic 的设计目标是完成真正需要的工作、展示已检查的内容，并在任务完成时停止，不会人为拉长进度或制造等待。性能会因设备、存储、可访问内容以及你选择的任务而变化。',
    speedAlt: '为保护隐私而隐藏单次运行数据的 Deep Scan 完成界面。',
    proofTitle: '用证据说话，而不是承诺。',
    proofLead: 'Bearagnostic 把清理决定留给你。你可以先查看将发生什么变化，在删除任何内容前确认，只有 Android 确认结果后，系统才会计算已回收空间。',
    proofAlt: ['隐藏单次运行信息的重复文件选择界面。','隐藏单次运行数值的最终确认界面。','隐藏单次运行数值的已验证结果界面。'],
  },
  'zh-tw': {
    speedTitle: '快，是設計出來的。絕不虛假拖延。',
    speedLead: 'Bearagnostic 的設計是完成真正需要的工作、顯示已檢查的內容，並在任務完成時停止，不會刻意拉長進度或製造等待。效能會依裝置、儲存空間、可存取內容以及你選擇的工作而不同。',
    speedAlt: '為保護隱私而隱藏單次執行資料的 Deep Scan 完成畫面。',
    proofTitle: '用證據說話，而不是承諾。',
    proofLead: 'Bearagnostic 把清理決定留給你。你可以先檢查將發生什麼變化，在刪除任何內容前確認，只有 Android 確認結果後，系統才會計算已回收空間。',
    proofAlt: ['隱藏單次執行資訊的重複檔案選擇畫面。','隱藏單次執行數值的最終確認畫面。','隱藏單次執行數值的已驗證結果畫面。'],
  },
  ar: {
    speedTitle: 'سريع بتصميمه. بلا انتظار مصطنع.',
    speedLead: 'صُمم Bearagnostic لتنفيذ العمل المهم، وإظهار ما تمت مراجعته، والتوقف عند اكتمال المهمة — من دون إطالة مصطنعة لشريط التقدم أو انتظار وهمي. يختلف الأداء بحسب الجهاز والتخزين والمحتوى المتاح والمهمة التي تختارها.',
    speedAlt: 'شاشة اكتمال Deep Scan مع إخفاء قيم التشغيل الخاصة حفاظاً على الخصوصية.',
    proofTitle: 'دليل، لا وعود.',
    proofLead: 'يبقي Bearagnostic قرارات التنظيف بين يديك. تراجع ما سيتغير، وتؤكد قبل إزالة أي شيء، ولا تُحتسب المساحة كمستعادة إلا بعد أن يؤكد Android النتيجة.',
    proofAlt: ['شاشة اختيار النسخ المكررة مع إخفاء بيانات التشغيل.','مراجعة نهائية مع إخفاء قيم التشغيل.','نتيجة موثقة مع إخفاء قيم التشغيل.'],
  },
  hi: {
    speedTitle: 'डिज़ाइन से तेज़। दिखावटी इंतज़ार नहीं।',
    speedLead: 'Bearagnostic को जरूरी काम करने, जो जाँचा गया उसे दिखाने और काम पूरा होते ही रुकने के लिए बनाया गया है — बिना प्रगति को कृत्रिम रूप से बढ़ाए या नकली प्रतीक्षा के। प्रदर्शन डिवाइस, स्टोरेज, उपलब्ध सामग्री और आपके चुने गए काम पर निर्भर करता है।',
    speedAlt: 'गोपनीयता के लिए रन-विशिष्ट मान हटाए गए Deep Scan परिणाम।',
    proofTitle: 'वादे नहीं, प्रमाण।',
    proofLead: 'Bearagnostic सफ़ाई के फैसले आपके हाथ में रखता है। आप देखते हैं कि क्या बदलेगा, कुछ भी हटने से पहले पुष्टि करते हैं, और जगह को तभी वापस मिली माना जाता है जब Android परिणाम की पुष्टि कर दे।',
    proofAlt: ['रन डेटा हटाकर दिखाया गया डुप्लिकेट चयन।','रन मान हटाकर दिखाया गया अंतिम रिव्यू।','रन मान हटाकर दिखाया गया सत्यापित परिणाम।'],
  },
  tr: {
    speedTitle: 'Tasarım gereği hızlı. Yapay bekleme yok.',
    speedLead: 'Bearagnostic önemli işi yapmak, nelerin incelendiğini göstermek ve görev tamamlandığında durmak üzere tasarlanmıştır — yapay biçimde uzatılan ilerleme veya sahte bekleme olmadan. Performans; cihaza, depolamaya, erişilebilir içeriğe ve seçtiğiniz göreve göre değişir.',
    speedAlt: 'Gizlilik için çalışmaya özel değerleri gizlenmiş Deep Scan sonuç ekranı.',
    proofTitle: 'Söz değil, kanıt.',
    proofLead: 'Bearagnostic temizlik kararlarını sizin elinizde tutar. Neyin değişeceğini gözden geçirir, herhangi bir şey kaldırılmadan önce onaylar ve alanı ancak Android sonucu doğruladıktan sonra geri kazanılmış olarak sayar.',
    proofAlt: ['Çalışmaya özel verileri gizlenmiş kopya seçim ekranı.','Çalışmaya özel değerleri gizlenmiş son inceleme.','Çalışmaya özel değerleri gizlenmiş doğrulanmış sonuç.'],
  },
} as const;

const story = copy[locale as keyof typeof copy] ?? copy.en;
---

<article class="feature-story story-chapter story-speed" aria-labelledby="story-speed-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">04</span>
    <h3 id="story-speed-title">{story.speedTitle}</h3>
    <p>{story.speedLead}</p>
  </div>

  <div class="feature-story-visual story-visual story-speed-visual">
    <figure class="story-screen story-speed-screen">
      <img
        src="/products/bearagnostic/showcase/section-04-deep-scan-privacy-safe.webp"
        alt={story.speedAlt}
        width="691"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <figure class="story-mascot story-speed-mascot" aria-hidden="true">
      <img
        src="/products/bearagnostic/showcase/dr-bear-speed-runner.png"
        alt=""
        width="1536"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</article>

<article class="feature-story story-chapter story-proof" aria-labelledby="story-proof-title">
  <div class="feature-story-copy story-copy">
    <span class="feature-number">05</span>
    <h3 id="story-proof-title">{story.proofTitle}</h3>
    <p>{story.proofLead}</p>
  </div>

  <div class="feature-story-visual story-visual story-proof-visual">
    <figure class="story-screen story-proof-a">
      <img src="/products/bearagnostic/showcase/section-05-exact-duplicates-privacy-safe.webp" alt={story.proofAlt[0]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-screen story-proof-b">
      <img src="/products/bearagnostic/showcase/section-05-final-review-privacy-safe.webp" alt={story.proofAlt[1]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-screen story-proof-c">
      <img src="/products/bearagnostic/showcase/section-05-verified-cleanup-privacy-safe.webp" alt={story.proofAlt[2]} width="691" height="1536" loading="lazy" decoding="async" />
    </figure>
    <figure class="story-mascot story-proof-mascot" aria-hidden="true">
      <img src="/products/bearagnostic/showcase/dr-bear-verified-shield-final.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" />
    </figure>
  </div>
</article>

<style>
  /* 04–05 intentionally mirror the production grammar used by 01–03. */
  .story-chapter {
    position: relative !important;
    display: grid !important;
    align-items: center !important;
    min-height: 650px !important;
    padding: clamp(1.9rem, 3vw, 2.65rem) !important;
    overflow: hidden !important;
    border: 1px solid rgba(30,103,163,.085) !important;
    border-radius: 40px !important;
    box-shadow: 0 30px 76px rgba(25,68,108,.085), inset 0 1px 0 rgba(255,255,255,.96) !important;
  }

  .story-speed {
    grid-template-columns: minmax(570px, 1.2fr) minmax(300px, .8fr) !important;
    gap: clamp(1.8rem, 3.5vw, 3.8rem) !important;
    background:
      radial-gradient(circle at 14% 18%, rgba(67,196,239,.125), transparent 24rem),
      radial-gradient(circle at 64% 90%, rgba(75,131,245,.065), transparent 24rem),
      linear-gradient(145deg, rgba(255,255,255,.995), rgba(245,251,255,.965)) !important;
  }

  .story-proof {
    grid-template-columns: minmax(300px, .82fr) minmax(570px, 1.18fr) !important;
    gap: clamp(1.8rem, 3.5vw, 3.8rem) !important;
    background:
      radial-gradient(circle at 88% 16%, rgba(111,99,220,.105), transparent 24rem),
      radial-gradient(circle at 65% 88%, rgba(61,188,145,.075), transparent 24rem),
      linear-gradient(145deg, rgba(255,255,255,.997), rgba(248,248,255,.972)) !important;
  }

  .story-speed .story-copy { order: 2 !important; }
  .story-speed .story-visual { order: 1 !important; }
