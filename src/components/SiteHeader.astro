---
import { site } from '../data/site';
import {
  getLocaleContent,
  localizedPath,
  stripLocalePrefix,
  type LocaleCode,
} from '../i18n/content';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: LocaleCode;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;
const copy = getLocaleContent(locale);
const basePath = stripLocalePrefix(currentPath);
const homePath = localizedPath(locale, '/');
const nav = [
  { label: copy.nav.home, href: `${homePath}#home`, key: 'home' },
  { label: copy.nav.products, href: `${homePath}#bearagnostic`, key: 'products' },
  { label: copy.nav.philosophy, href: `${homePath}#philosophy`, key: 'philosophy' },
  { label: copy.nav.support, href: localizedPath(locale, '/support'), key: 'support' },
] as const;

const isActive = (key: string) => {
  if (key === 'home') return basePath === '/';
  if (key === 'support') return basePath.startsWith('/support');
  return false;
};
---

<header class="bi-header">
  <div class="bi-header-inner">
    <a class="bi-brand" href={`${homePath}#home`} aria-label={`${site.name} home`}>
      <span class="bi-brand-mark" aria-hidden="true">
        <img src="/brand/benedict-mark.png" alt="" width="609" height="754" decoding="async" />
      </span>
      <span class="bi-brand-copy">
        <strong>BENEDICT</strong>
        <small>INTERACTIVE</small>
      </span>
    </a>

    <nav class="bi-desktop-nav" aria-label={copy.nav.menu}>
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.key) }} aria-current={isActive(item.key) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="bi-header-actions">
      <div class="bi-language-wrap">
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
      </div>
      <a class="bi-header-cta" href={`${homePath}#bearagnostic`}>
        {copy.common.footerLine}<span aria-hidden="true">→</span>
      </a>

      <details class="bi-mobile-menu">
        <summary aria-label={copy.nav.menu} title={copy.nav.menu}>
          <span></span><span></span><span></span>
        </summary>
        <nav class="bi-mobile-panel" aria-label={copy.nav.menu}>
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.key) }}>
              {item.label}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .bi-header {
    position: sticky;
    z-index: 100;
    inset-block-start: 0;
    padding: 0.55rem 1rem 0;
    pointer-events: none;
  }
  .bi-header-inner {
    display: grid;
    grid-template-columns: minmax(190px, 1fr) auto minmax(250px, 1fr);
    gap: 1rem;
    align-items: center;
    width: min(1240px, 100%);
    min-height: 60px;
    margin-inline: auto;
    padding: 0.42rem 0.62rem 0.42rem 0.76rem;
    border: 1px solid rgba(255,255,255,0.92);
    border-radius: 20px;
    background: rgba(251,253,255,0.9);
    box-shadow: 0 10px 34px rgba(26,58,92,0.07);
    backdrop-filter: blur(18px) saturate(140%);
    pointer-events: auto;
  }
  .bi-brand { display: inline-flex; gap: 0.68rem; align-items: center; width: fit-content; color: #0e2340; text-decoration: none; }
  .bi-brand-mark { display: grid; width: 39px; height: 39px; place-items: center; overflow: hidden; border-radius: 11px; background: linear-gradient(145deg,#eff9ff,#fff); }
  .bi-brand-mark img { width: 34px; height: 34px; object-fit: contain; }
  .bi-brand-copy { display: grid; line-height: 1; }
  .bi-brand-copy strong { font-size: 0.88rem; letter-spacing: 0.12em; }
  .bi-brand-copy small { margin-top: 0.2rem; color: #49698e; font-size: 0.5rem; font-weight: 750; letter-spacing: 0.31em; }
  .bi-desktop-nav { display: flex; gap: 0.15rem; align-items: center; justify-content: center; }
  .bi-desktop-nav a {
    position: relative;
    padding: 0.66rem 0.82rem;
    color: #52657c;
    border-radius: 11px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 680;
    line-height: var(--type-ui-leading);
    text-decoration: none;
  }
  .bi-desktop-nav a:hover, .bi-desktop-nav a.active { color: #0f579e; background: rgba(229,243,254,0.76); }
  .bi-desktop-nav a.active::after { position: absolute; inset-inline: 30%; inset-block-end: 0.22rem; height: 2px; border-radius: 999px; background: #1b8af5; content: ""; }
  .bi-header-actions { display: flex; gap: 0.45rem; align-items: center; justify-content: flex-end; }
  .bi-header-cta {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    max-width: 240px;
    min-height: 42px;
    padding: 0.45rem 0.95rem;
    overflow: hidden;
    color: #fff;
    border-radius: 999px;
    background: linear-gradient(135deg,#087ff0,#22a8f5);
    box-shadow: 0 9px 24px rgba(17,129,235,0.18);
    font-family: var(--font-body);
    font-size: 0.69rem;
    font-weight: 760;
    line-height: var(--type-ui-leading);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bi-mobile-menu { position: relative; display: none; }
  .bi-mobile-menu > summary { display: grid; width: 42px; height: 42px; place-content: center; gap: 4px; cursor: pointer; list-style: none; border: 1px solid #d7e6f1; border-radius: 14px; background: #fff; }
  .bi-mobile-menu > summary::-webkit-details-marker { display:none; }
  .bi-mobile-menu > summary span { width: 17px; height: 2px; border-radius: 999px; background: #3378b8; }
  .bi-mobile-panel { position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + 0.55rem); display: grid; width: min(78vw,280px); padding: 0.55rem; border: 1px solid #dce8f2; border-radius: 18px; background: rgba(255,255,255,0.98); box-shadow: 0 20px 55px rgba(29,59,93,0.16); }
  .bi-mobile-panel a {
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0.82rem 0.9rem;
    color:#334d68;
    border-radius:12px;
    font-family: var(--font-body);
    font-size:0.9rem;
    font-weight:680;
    line-height: var(--type-ui-leading);
    text-decoration:none;
  }
  .bi-mobile-panel a.active { color:#0f67b9; background:#eef8ff; }
  :global(.bi-language-wrap .language-switcher > summary) { min-height: 42px; }
  @media (max-width: 980px) {
    .bi-header-inner { grid-template-columns: 1fr auto; }
    .bi-desktop-nav, .bi-header-cta { display:none; }
    .bi-mobile-menu { display:block; }
  }
  @media (max-width: 520px) {
    .bi-header { padding:0.42rem 0.5rem 0; }
    .bi-header-inner { min-height:57px; padding:0.38rem 0.42rem 0.38rem 0.55rem; border-radius:17px; }
    .bi-brand-mark { width:35px; height:35px; border-radius:10px; }
    .bi-brand-mark img { width:30px; height:30px; }
    .bi-brand-copy strong { font-size:0.76rem; }
    .bi-brand-copy small { font-size:0.44rem; }
    .bi-mobile-menu > summary { width:39px; height:39px; }
  }
</style>
