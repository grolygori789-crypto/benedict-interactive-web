---
import { site } from '../data/site';
import {
  getLocaleContent,
  localizedPath,
  stripLocalePrefix,
  type LocaleCode,
} from '../i18n/content';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: LocaleCode;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;
const copy = getLocaleContent(locale);
const basePath = stripLocalePrefix(currentPath);
const nav = [
  { label: copy.nav.home, href: localizedPath(locale, '/'), key: 'home' },
  { label: copy.nav.products, href: localizedPath(locale, '/products'), key: 'products' },
  { label: copy.nav.philosophy, href: `${localizedPath(locale, '/')}#philosophy`, key: 'philosophy' },
  { label: copy.nav.support, href: localizedPath(locale, '/support'), key: 'support' },
] as const;

const isActive = (key: string) => {
  if (key === 'home') return basePath === '/';
  if (key === 'products') return basePath.startsWith('/products');
  if (key === 'support') return basePath.startsWith('/support');
  return false;
};
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={localizedPath(locale, '/')} aria-label={`${site.name} home`}>
      <span class="brand-symbol" aria-hidden="true">
        <img src="/brand/benedict-mark.png" alt="" width="609" height="754" decoding="async" />
      </span>
      <span class="brand-copy">
        <strong>Benedict</strong>
        <small>Interactive</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={copy.nav.menu}>
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.key) }} aria-current={isActive(item.key) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <LanguageSwitcher locale={locale} currentPath={currentPath} />

      <details class="mobile-menu">
        <summary aria-label={copy.nav.menu} title={copy.nav.menu}>
          <span></span><span></span><span></span>
        </summary>
        <nav class="mobile-menu-panel" aria-label={copy.nav.menu}>
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.key) }} aria-current={isActive(item.key) ? 'page' : undefined}>
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
