---
import SiteLayout from '../layouts/SiteLayout.astro';
import { productCatalog } from '../data/products';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const page = copy.products;
const bearProduct = productCatalog.find((product) => product.slug === 'bearagnostic');

if (!bearProduct) {
  throw new Error('Bearagnostic product metadata is missing from the product catalog.');
}
---

<SiteLayout title={copy.nav.products} description={page.metaDescription} locale={locale}>
  <section class="page-hero shell">
    <p class="section-label">{page.kicker}</p>
    <h1>{page.title}</h1>
    <p>{page.lead}</p>
  </section>

  <section class="products-showcase shell" aria-label={copy.nav.products} data-product-count={productCatalog.length}>
    <article class="product-panel product-panel-bear" data-product={bearProduct.slug}>
      <div class="product-panel-copy">
        <div class="product-status-row">
          <span class="status-pill">{copy.common.inDevelopment}</span>
          <span>{bearProduct.platform}</span>
        </div>
        <p class="section-label">Bearagnostic</p>
        <h2>{copy.home.productPromise}</h2>
        <p>{page.bearDescription}</p>
        <a class="button button-primary" href={localizedPath(locale, bearProduct.path)}>
          {page.bearCta}
        </a>
      </div>
      <div class="product-panel-art" aria-label="Bearagnostic">
        <img
          src={bearProduct.heroAsset}
          alt={bearProduct.heroAlt}
          width={bearProduct.heroWidth}
          height={bearProduct.heroHeight}
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article class="product-panel product-panel-lab" id="test-center">
      <div class="lab-symbol" aria-hidden="true">
        <img src="/brand/benedict-logo.png" alt="" width="1170" height="1780" loading="lazy" decoding="async" />
      </div>
      <div class="product-panel-copy">
        <span class="status-pill status-muted">{copy.common.planned}</span>
        <p class="section-label">{page.testKicker}</p>
        <h2>{page.testTitle}</h2>
        <p>{page.testDescription}</p>
        <p class="fine-note">{page.testNote}</p>
      </div>
    </article>
  </section>
</SiteLayout>

<style>
  .products-showcase {
    container-type: inline-size;
  }

  .product-panel-bear .product-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: #60758d;
    font-size: 0.78rem;
    font-weight: 680;
  }

  .product-panel-art {
    position: relative;
    isolation: isolate;
  }

  .product-panel-lab {
    align-items: center;
  }

  .product-panel-lab .lab-symbol {
    display: grid;
    place-items: center;
    min-width: 0;
    align-self: stretch;
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
    border-radius: clamp(1.5rem, 2.4vw, 2rem);
    background:
      radial-gradient(circle at 18% 18%, rgba(42, 186, 241, 0.1), transparent 13rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(245, 249, 252, 0.96));
    box-shadow: inset 0 0 0 1px rgba(14, 54, 96, 0.04);
  }

  .product-panel-lab .lab-symbol img {
    width: min(100%, 260px);
    height: auto;
    object-fit: contain;
  }

  @container (max-width: 760px) {
    .product-panel-lab .lab-symbol {
      padding: 1rem;
    }

    .product-panel-lab .lab-symbol img {
      width: min(100%, 220px);
    }
  }
</style>
