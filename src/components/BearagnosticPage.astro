const proValue = proValueCopy[locale] ?? proValueCopy.en;

const featureMedia = [
  {
    primary: '/products/bearagnostic/app-scan-depth.webp',
    secondary: '/products/bearagnostic/app-scan-progress.webp',
    secondaryKind: 'detail',
  },
  {
    primary: '/products/bearagnostic/app-scan-safe.webp',
    secondary: '/products/bearagnostic/app-cleanup-categories.webp',
    tertiary: '/products/bearagnostic/app-older-files.webp',
    secondaryKind: 'phone',
  },
  {
    primary: '/products/bearagnostic/app-tools.webp',
    secondary: '/products/bearagnostic/app-insights.webp',
    tertiary: '/products/bearagnostic/app-insights-trend.webp',
    secondaryKind: 'phone',
  },
] as const;

const stepIcons = ['spark', 'wallet', 'shield', 'unlock'] as const;
const faqColumnBreak = Math.ceil(launch.faqItems.length / 2);
const faqColumns = [
  launch.faqItems.slice(0, faqColumnBreak),
  launch.faqItems.slice(faqColumnBreak),
] as const;
---

<SiteLayout title="Bearagnostic" description={page.metaDescription} locale={locale}>
  <div class="bear-page">
    <section class="bear-hero shell" aria-labelledby="bear-title">
      <div class="bear-hero-copy">
        <p class="section-label">{page.kicker}</p>
        <div class="product-status-row">
          <span class="status-pill status-ready">{launch.status}</span>
        </div>

        <h1 id="bear-title" class="bear-title-wordmark" aria-label={page.title}>
          <span class="bear-title-dark">Bear</span><span class="bear-title-blue">agnostic</span>
        </h1>

        <p class="bear-promise">{page.promise}</p>
        <p class="bear-lead">{page.lead}</p>
        <a class="text-link bear-support-link" href={localizedPath(locale, '/support')}>
          {page.supportCta}<span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="bear-showcase" aria-label={page.title}>
        <div class="bear-showcase-lockup" aria-hidden="true">
          <span>DEVICE HEALTH</span>
          <i></i>
          <span>BETTER DAYS</span>
        </div>

        <figure class="bear-character-hero">
          <img
            src="/products/bearagnostic/dr-bear.png"
            alt="Dr. Bear giving a thumbs-up while holding a tablet"
            width="1254"
            height="1254"
            loading="eager"
            decoding="async"
          />
        </figure>

        <figure class="bear-phone-hero phone-card">
          <div class="phone-speaker" aria-hidden="true"></div>
          <div class="phone-screen">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="eager"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="release-truth" aria-labelledby="release-truth-title" data-artifact-state={artifactState.status}>
      <div class="shell release-truth-shell">
        <div class="release-copy">
          <p class="section-label">{launch.releaseKicker}</p>
          <AccentHeading as="h2" id="release-truth-title" class="release-title" text={launch.releaseTitle} />
          <p>{launch.releaseLead}</p>

          <dl class="release-facts">
            <div><dt>{launch.versionLabel}</dt><dd>{bearagnosticRelease.versionName}</dd></div>
            <div><dt>{launch.buildLabel}</dt><dd>B{bearagnosticRelease.versionCode}</dd></div>
            <div class="release-hash"><dt>{launch.shaLabel}</dt><dd><code>{bearagnosticRelease.apkSha256}</code></dd></div>
            <div><dt>{launch.appLanguagesLabel}</dt><dd>{bearagnosticRelease.appLanguages.join(' · ')}</dd></div>
          </dl>

          <div class="release-disclosure-grid">
            <article><strong>{launch.appLanguagesLabel}</strong><p>{launch.appLanguagesBody}</p></article>
            <article><strong>{launch.websiteLanguagesLabel}</strong><p>{launch.websiteLanguagesBody}</p></article>
            <article><strong>{launch.distributionLabel}</strong><p>{launch.distributionBody}</p></article>
          </div>
        </div>

        <aside class="download-card">
          <div class="download-card-top">
            <span class="download-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
            </span>
            <div>
              <span class="download-file-label">APK</span>
              <strong>{bearagnosticRelease.apkFilename}</strong>
            </div>
          </div>

          {downloadVerified ? (
            <a class="download-button" href={bearagnosticRelease.publicPath} download data-analytics="bearagnostic-download">
              <span>{launch.downloadCta}</span><span aria-hidden="true">↓</span>
            </a>
          ) : (
            <span class="download-button is-disabled" aria-disabled="true">
              <span>{launch.downloadPending}</span><span aria-hidden="true">…</span>
            </span>
          )}

          <p class="download-integrity-note">{launch.exactBinaryNote}</p>

          <nav class="download-legal-links" aria-label={legal.legalGroup}>
            <a href={localizedPath(locale, '/privacy')}>{legal.privacy}</a>
            <a href={localizedPath(locale, '/terms')}>{legal.terms}</a>
            <a href={localizedPath(locale, '/license')}>{legal.softwareLicense}</a>
          </nav>

          <div class="release-notes">
            <h3>{launch.releaseNotesTitle}</h3>
            <ul>{launch.releaseNotes.map((note) => <li>{note}</li>)}</ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="bear-features" aria-labelledby="bear-features-title">
      <div class="shell">
        <p class="section-label">{page.featuresKicker}</p>
        <AccentHeading as="h2" id="bear-features-title" class="bear-section-title" text={page.featuresTitle} />

        <div class="feature-stories">
          {polishedFeatures.map((item, index) => {
            const media = featureMedia[index];
            return (
              <article class="feature-story">
                <div class="feature-story-copy">
                  <span class="feature-number">0{index + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>

                <div class={`feature-story-visual feature-story-visual-${index + 1}`} aria-hidden="true">
                  <figure class="product-device device-primary">
                    <span class="device-speaker"></span>
                    <img src={media.primary} alt="" width="691" height="1536" loading="lazy" decoding="async" />
                  </figure>

                  <figure class:list={[
                    'device-secondary',
                    media.secondaryKind === 'detail' ? 'product-detail' : 'product-device'
                  ]}>
                    {media.secondaryKind === 'phone' && <span class="device-speaker"></span>}
                    <img
                      src={media.secondary}
                      alt=""
                      width="691"
                      height={media.secondaryKind === 'detail' ? '555' : '1536'}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>

                  {'tertiary' in media && media.tertiary && (
                    <figure class="product-detail device-tertiary">
                      <img
                        src={media.tertiary}
                        alt=""
                        width="691"
                        height={index === 1 ? '1115' : '1536'}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                </div>
              </article>
            );
          })}

          <BearagnosticStorySections45 locale={locale} />
        </div>
      </div>
    </section>

    <section class="pro-upgrade" aria-labelledby="pro-title">
      <div class="shell pro-upgrade-shell">
        <div class="pro-copy">
          <div class="pro-kicker-row">
            <p class="section-label">{page.proKicker}</p>
            <span class="pro-lifetime-pill">{commerce.lifetime}</span>
          </div>
          <AccentHeading as="h2" id="pro-title" class="commerce-title" text={proValue.title} />
          <p class="pro-lead">{proValue.lead}</p>

          <p class="pro-benefits-label">{proValue.featuresLabel}</p>
          <div class="pro-benefits" role="list">
            {proValue.benefits.map((benefit, index) => (
              <div class={`pro-benefit pro-benefit-${index + 1}`} role="listitem">
                <span class="pro-benefit-icon" aria-hidden="true">
                  {index === 0 && <svg viewBox="0 0 24 24"><path d="m12 3 8 4-8 4-8-4z"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4"/></svg>}
                  {index === 1 && <svg viewBox="0 0 24 24"><path d="M4 6h10M18 6h2M10 12h10M4 12h2M4 18h10M18 18h2"/><circle cx="16" cy="6" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="18" r="2"/></svg>}
                  {index === 2 && <svg viewBox="0 0 24 24"><rect x="4" y="7" width="11" height="11" rx="2"/><rect x="9" y="3" width="11" height="11" rx="2"/><path d="m8.5 12.5 2 2 4-4"/></svg>}
