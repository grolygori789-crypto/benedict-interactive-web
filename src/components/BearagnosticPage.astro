---
import SiteLayout from '../layouts/SiteLayout.astro';
import AccentHeading from './AccentHeading.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const page = copy.bear;

const featureMedia = [
  {
    primary: '/products/bearagnostic/app-scan-depth.webp',
    secondary: '/products/bearagnostic/app-scan-progress.webp',
    secondaryKind: 'detail',
  },
  {
    primary: '/products/bearagnostic/app-scan-safe.webp',
    secondary: '/products/bearagnostic/app-cleanup-categories.webp',
    tertiary: '/products/bearagnostic/app-older-files.webp',
    secondaryKind: 'phone',
  },
  {
    primary: '/products/bearagnostic/app-tools.webp',
    secondary: '/products/bearagnostic/app-insights.webp',
    tertiary: '/products/bearagnostic/app-insights-trend.webp',
    secondaryKind: 'phone',
  },
] as const;
---

<SiteLayout title="Bearagnostic" description={page.metaDescription} locale={locale}>
  <div class="bear-page">
    <section class="bear-hero shell" aria-labelledby="bear-title">
      <div class="bear-hero-copy">
        <p class="section-label">{page.kicker}</p>
        <div class="product-status-row">
          <span class="status-pill">{copy.common.inDevelopment}</span>
          <span>Android</span>
        </div>

        <h1 id="bear-title" class="bear-title-wordmark" aria-label={page.title}>
          <span class="bear-title-dark">Bear</span><span class="bear-title-blue">agnostic</span>
        </h1>

        <p class="bear-promise">{page.promise}</p>
        <p class="bear-lead">{page.lead}</p>
        <a class="text-link bear-support-link" href={localizedPath(locale, '/support')}>
          {page.supportCta}<span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="bear-showcase" aria-label={page.title}>
        <div class="bear-showcase-lockup" aria-hidden="true">
          <span>DEVICE HEALTH</span>
          <i></i>
          <span>BETTER DAYS</span>
        </div>

        <figure class="bear-character-hero">
          <img
            src="/products/bearagnostic/dr-bear.png"
            alt="Dr. Bear giving a thumbs-up while holding a tablet"
            width="1254"
            height="1254"
            loading="eager"
            decoding="async"
          />
        </figure>

        <figure class="bear-phone-hero phone-card">
          <div class="phone-speaker" aria-hidden="true"></div>
          <div class="phone-screen">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="eager"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="bear-features" aria-labelledby="bear-features-title">
      <div class="shell">
        <p class="section-label">{page.featuresKicker}</p>
        <AccentHeading as="h2" id="bear-features-title" class="bear-section-title" text={page.featuresTitle} />

        <div class="feature-stories">
          {page.features.map((item, index) => {
            const media = featureMedia[index];
            return (
              <article class="feature-story">
                <div class="feature-story-copy">
                  <span class="feature-number">0{index + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>

                <div class={`feature-story-visual feature-story-visual-${index + 1}`} aria-hidden="true">
                  <figure class="product-device device-primary">
                    <span class="device-speaker"></span>
                    <img src={media.primary} alt="" width="691" height="1536" loading="lazy" decoding="async" />
                  </figure>

                  <figure class:list={[
                    'device-secondary',
                    media.secondaryKind === 'detail' ? 'product-detail' : 'product-device'
                  ]}>
                    {media.secondaryKind === 'phone' && <span class="device-speaker"></span>}
                    <img
                      src={media.secondary}
                      alt=""
                      width="691"
                      height={media.secondaryKind === 'detail' ? '555' : '1536'}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>

                  {'tertiary' in media && media.tertiary && (
                    <figure class="product-detail device-tertiary">
                      <img
                        src={media.tertiary}
                        alt=""
                        width="691"
                        height={index === 1 ? '1115' : '1536'}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="commerce-section shell" aria-labelledby="pro-title">
      <div class="commerce-copy">
        <p class="section-label">{page.proKicker}</p>
        <AccentHeading as="h2" id="pro-title" class="commerce-title" text={page.proTitle} />
        <p>{page.proBody}</p>
        <ul>
          {page.proPoints.map((point) => <li>{point}</li>)}
        </ul>
        <div class="commerce-action" data-commerce-state="planned" aria-live="polite">
          <div class="commerce-status">
            <span class="status-dot" aria-hidden="true"></span>
            <strong>{page.proStatus}</strong>
          </div>
          <p class="fine-note">{page.proNote}</p>
        </div>
      </div>

      <div class="commerce-visual" aria-hidden="true">
        <span class="pro-orbit">PRO</span>
        <span class="commerce-halo"></span>
        <img
          src="/products/bearagnostic/dr-bear-warning.png"
          alt=""
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .bear-page {
    overflow: clip;
  }

  .bear-page .bear-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(2.6rem, 6vw, 6rem);
    align-items: center;
    min-height: min(780px, calc(100svh - 76px));
    padding-block: clamp(4.4rem, 7vw, 6.8rem);
  }

  .bear-page .bear-hero-copy {
    min-width: 0;
    max-width: 560px;
  }

  .bear-page .product-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-block-end: 1rem;
    color: #53677f;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .bear-title-wordmark {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    overflow: visible;
    color: #071a39;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: clamp(3.25rem, 5vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.062em;
    line-height: 0.96;
    white-space: nowrap;
  }

  .bear-title-dark { color: #071a39; }
  .bear-title-blue { color: #1688f3; }

  .bear-page .bear-promise {
    margin-block-start: 1.3rem;
    color: #1c5f9e;
    font-size: clamp(1.16rem, 1.55vw, 1.4rem);
    font-weight: 780;
    line-height: 1.42;
  }

  .bear-page .bear-lead {
    max-width: 540px;
    margin-block-start: 1.05rem;
    color: #667b95;
    line-height: 1.74;
  }

  .bear-page .bear-support-link { margin-block-start: 0.9rem; }

  .bear-showcase {
    position: relative;
    min-width: 0;
    min-height: clamp(500px, 41vw, 610px);
    isolation: isolate;
  }

  .bear-showcase::before {
    position: absolute;
    z-index: -2;
    inset: 8% 2% 2% 7%;
    border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%;
    background:
      radial-gradient(circle at 45% 45%, rgba(255,255,255,0.98), rgba(242,250,255,0.9) 48%, rgba(224,243,252,0.55) 70%, transparent 90%);
    content: "";
    pointer-events: none;
  }

  .bear-showcase::after {
    position: absolute;
    z-index: -1;
    inset-inline-end: 10%;
    inset-block-end: 3%;
    width: 50%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(28, 76, 123, 0.10), transparent 70%);
    filter: blur(16px);
    content: "";
    pointer-events: none;
  }

  .bear-showcase-lockup {
    position: absolute;
    z-index: 5;
    inset-block-start: 3%;
    inset-inline-end: 2%;
    display: grid;
    grid-template-columns: auto 28px auto;
    align-items: center;
    gap: 0.55rem;
    color: #657d98;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .bear-showcase-lockup i {
    display: block;
    width: 28px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, #167bf2, #35c5de);
  }

  .bear-character-hero {
    position: absolute;
    z-index: 2;
    inset-inline-start: 1%;
    inset-block-end: 0;
    width: min(72%, 550px);
    margin: 0;
  }

  .bear-character-hero img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    image-rendering: auto;
  }

  .bear-page .bear-phone-hero {
    position: absolute;
    z-index: 4;
    inset-inline-end: 1%;
    inset-block-end: 5%;
    width: min(30%, 225px);
    margin: 0;
    padding: 6px;
    overflow: hidden;
    border: 1px solid rgba(20, 67, 114, 0.08);
    border-radius: 31px;
    background: #fff;
    box-shadow: 0 24px 65px rgba(28, 78, 129, 0.16);
    transform: rotate(1.4deg);
  }

  .bear-page .bear-phone-hero .phone-screen {
    overflow: hidden;
    border-radius: 24px;
  }

  .bear-page .bear-phone-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 691 / 1536;
    object-fit: cover;
  }

  .bear-page .bear-features {
    padding-block: clamp(5.2rem, 8vw, 7.2rem);
    border-block: 1px solid rgba(12, 47, 91, 0.07);
    background:
      radial-gradient(circle at 92% 12%, rgba(83, 196, 222, 0.09), transparent 25rem),
      linear-gradient(180deg, rgba(248, 252, 255, 0.82), rgba(255, 255, 255, 0.98));
  }

  :global(.bear-section-title) {
    max-width: 820px;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.01;
    letter-spacing: var(--type-heading-tracking, -0.045em);
  }

  .feature-stories {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.3rem);
    margin-block-start: clamp(3rem, 5vw, 4.8rem);
  }

  .feature-story {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(430px, 1.22fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: 650px;
    padding: clamp(1.45rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid rgba(17, 60, 103, 0.08);
    border-radius: 38px;
    background:
      radial-gradient(circle at 82% 14%, rgba(43, 114, 246, 0.08), transparent 24rem),
      rgba(255, 255, 255, 0.88);
    box-shadow: 0 22px 64px rgba(31, 48, 72, 0.08);
  }

  .feature-story:nth-child(2) {
    background:
      radial-gradient(circle at 18% 18%, rgba(122, 115, 230, 0.08), transparent 23rem),
      rgba(255, 255, 255, 0.9);
  }

  .feature-story:nth-child(3) {
    background:
      radial-gradient(circle at 82% 18%, rgba(72, 173, 121, 0.08), transparent 23rem),
      rgba(255, 255, 255, 0.9);
  }

  .feature-story:nth-child(even) .feature-story-copy { order: 2; }
  .feature-story:nth-child(even) .feature-story-visual { order: 1; }

  .feature-story-copy {
    min-width: 0;
    max-width: 490px;
  }

  .feature-number {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: #176fc9;
    border: 1px solid rgba(43, 114, 246, 0.1);
    border-radius: 15px;
    background: rgba(43, 114, 246, 0.07);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .feature-story-copy h3 {
    margin-block-start: 1.2rem;
    font-size: clamp(2rem, 3.3vw, 3.15rem);
    line-height: 1.02;
  }

  .feature-story-copy p {
    margin-block-start: 1rem;
    color: #667b95;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: var(--type-body-leading, 1.72);
  }

  .feature-story-visual {
    position: relative;
    min-width: 0;
    min-height: 570px;
    isolation: isolate;
  }

  .feature-story-visual::before {
    position: absolute;
    z-index: -1;
    inset: 7% 4% 4%;
    border-radius: 42px;
    background:
      radial-gradient(circle at 48% 42%, rgba(255,255,255,0.98), rgba(236,247,255,0.78) 52%, rgba(224,242,252,0.36) 74%, transparent);
    content: "";
  }

  .product-device,
  .product-detail {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(22, 67, 111, 0.09);
    background: #fff;
    box-shadow: 0 24px 65px rgba(28, 78, 129, 0.15);
  }

  .product-device {
    padding: 6px;
    border-radius: 31px;
  }

  .product-device img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
  }

  .product-detail {
    border-radius: 24px;
  }

  .product-detail img {
    display: block;
    width: 100%;
    height: auto;
  }

  .device-speaker {
    position: absolute;
    z-index: 2;
    inset-block-start: 10px;
    inset-inline-start: 50%;
    width: 24%;
    height: 5px;
    border-radius: 999px;
    background: rgba(20, 42, 70, 0.1);
    transform: translateX(-50%);
  }

  .feature-story-visual-1 .device-primary {
    inset-inline-start: 7%;
    inset-block-start: 3%;
    width: min(47%, 255px);
    transform: rotate(-3.2deg);
  }

  .feature-story-visual-1 .device-secondary {
    inset-inline-end: 3%;
    inset-block-end: 9%;
    width: min(63%, 365px);
    transform: rotate(2deg);
  }

  .feature-story-visual-2 .device-primary {
    inset-inline-start: 3%;
    inset-block-start: 2%;
    width: min(43%, 245px);
    transform: rotate(-4deg);
  }

  .feature-story-visual-2 .device-secondary {
    inset-inline-end: 4%;
    inset-block-start: 12%;
    width: min(42%, 235px);
    transform: rotate(4deg);
  }

  .feature-story-visual-2 .device-tertiary {
    z-index: 4;
    inset-inline-start: 23%;
    inset-block-end: 0;
    width: min(55%, 330px);
  }

  .feature-story-visual-3 .device-primary {
    inset-inline-start: 4%;
    inset-block-start: 2%;
    width: min(42%, 240px);
    transform: rotate(-3deg);
  }

  .feature-story-visual-3 .device-secondary {
    inset-inline-end: 4%;
    inset-block-start: 9%;
    width: min(42%, 235px);
    transform: rotate(3.5deg);
  }

  .feature-story-visual-3 .device-tertiary {
    z-index: 4;
    inset-inline-start: 24%;
    inset-block-end: 0;
    width: min(53%, 320px);
    max-height: 245px;
  }

  .feature-story-visual-3 .device-tertiary img {
    transform: translateY(-42%);
  }

  .bear-page .commerce-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(390px, 0.72fr);
    gap: clamp(2.8rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(5.4rem, 8vw, 7.5rem);
  }

  .bear-page .commerce-copy { min-width: 0; }

  :global(.commerce-title) {
    max-width: 760px;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.02;
    letter-spacing: var(--type-heading-tracking, -0.045em);
  }

  .commerce-action {
    margin-block-start: 1.35rem;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid rgba(22, 92, 151, 0.10);
  }

  .commerce-action .fine-note { margin-block-start: 0.65rem; }

  .bear-page .commerce-visual {
    position: relative;
    min-height: 515px;
    isolation: isolate;
  }

  .commerce-halo {
    position: absolute;
    z-index: -1;
    inset: 12% 4% 5% 3%;
    border-radius: 48% 52% 45% 55% / 52% 45% 55% 48%;
    background:
      radial-gradient(circle at 47% 46%, rgba(255,255,255,0.96), rgba(42, 186, 241, 0.13) 45%, rgba(239, 173, 87, 0.055) 62%, transparent 78%);
  }

  .bear-page .commerce-visual img {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: 0;
    display: block;
    width: min(90%, 475px);
    height: auto;
    max-height: 100%;
    object-fit: contain;
    image-rendering: auto;
    transform: translateX(-50%);
  }

  .pro-orbit {
    position: absolute;
    z-index: 3;
    inset-block-start: 8%;
    inset-inline-start: 6%;
    display: grid;
    min-width: 58px;
    min-height: 34px;
    place-items: center;
    padding-inline: 0.8rem;
    color: #476b90;
    border: 1px solid rgba(36, 102, 166, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 32px rgba(33, 84, 135, 0.08);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  @media (max-width: 1120px) {
    .bear-page .bear-hero {
      grid-template-columns: minmax(0, 0.82fr) minmax(470px, 1.18fr);
      gap: 2.6rem;
    }

    .bear-title-wordmark { font-size: clamp(3.35rem, 5.25vw, 4.8rem); }
  }

  @media (max-width: 980px) {
    .bear-page .bear-hero,
    .bear-page .commerce-section {
      grid-template-columns: 1fr;
    }

    .bear-page .bear-hero {
      min-height: 0;
      gap: 1.2rem;
      padding-block-start: 4.2rem;
    }

    .bear-page .bear-hero-copy { max-width: 720px; }

    .feature-story {
      grid-template-columns: minmax(0, 0.8fr) minmax(390px, 1.2fr);
      gap: 2rem;
    }

    .bear-showcase {
      width: min(100%, 740px);
      min-height: 565px;
      margin-inline: auto;
    }

    .bear-page .commerce-section { gap: 1rem; }

    .bear-page .commerce-visual {
      width: min(100%, 600px);
      min-height: 500px;
      margin-inline: auto;
    }
  }

  @media (max-width: 680px) {
    .bear-page .bear-hero { padding-block: 3.2rem 2rem; }

    .bear-title-wordmark {
      font-size: clamp(2.45rem, 11.6vw, 3.55rem);
      letter-spacing: -0.058em;
    }

    .bear-page .bear-promise { font-size: 1.08rem; }

    :global(.bear-section-title),
    :global(.commerce-title) {
      font-size: clamp(2.55rem, 11vw, 3.75rem);
      line-height: 1.05;
    }

    .feature-story {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 1.3rem;
      padding: 1.2rem;
      border-radius: 29px;
    }

    .feature-story:nth-child(even) .feature-story-copy,
    .feature-story:nth-child(even) .feature-story-visual {
      order: initial;
    }

    .feature-story-copy { max-width: 100%; }

    .feature-story-copy h3 {
      font-size: clamp(1.75rem, 8vw, 2.55rem);
    }

    .feature-story-visual {
      min-height: min(118vw, 520px);
      max-width: 360px;
      margin-inline: auto;
    }

    .feature-story-visual::before {
      inset: 10% 10% 8%;
      border-radius: 36px;
      opacity: 0.5;
    }

    .feature-story-visual .product-device,
    .feature-story-visual .product-detail {
      box-shadow: 0 18px 48px rgba(28, 78, 129, 0.12);
    }

    .feature-story-visual-1 .device-primary {
      inset-inline-start: 50%;
      inset-block-start: 2%;
      width: min(54%, 220px);
      transform: translateX(-62%) rotate(-4deg);
    }

    .feature-story-visual-1 .device-secondary {
      inset-inline-start: 50%;
      inset-inline-end: auto;
      inset-block-end: 5%;
      width: min(78%, 308px);
      transform: translateX(-38%) rotate(1.8deg);
    }

    .feature-story-visual-2 .device-primary {
      inset-inline-start: 50%;
      inset-block-start: 4%;
      width: min(47%, 182px);
      transform: translateX(-96%) rotate(-7deg);
    }

    .feature-story-visual-2 .device-secondary {
      inset-inline-start: 50%;
      inset-inline-end: auto;
      inset-block-start: 12%;
      width: min(47%, 182px);
      transform: translateX(-2%) rotate(6deg);
    }

    .feature-story-visual-2 .device-tertiary {
      inset-inline-start: 50%;
      inset-block-end: 1%;
      width: min(74%, 284px);
      transform: translateX(-50%);
    }

    .feature-story-visual-3 .device-primary {
      inset-inline-start: 50%;
      inset-block-start: 4%;
      width: min(47%, 182px);
      transform: translateX(-96%) rotate(-6deg);
    }

    .feature-story-visual-3 .device-secondary {
      inset-inline-start: 50%;
      inset-inline-end: auto;
      inset-block-start: 11%;
      width: min(47%, 182px);
      transform: translateX(-2%) rotate(6deg);
    }

    .feature-story-visual-3 .device-tertiary {
      inset-inline-start: 50%;
      inset-block-end: 2%;
      width: min(74%, 285px);
      max-height: 245px;
      transform: translateX(-50%);
    }

    .feature-story-visual-3 .device-tertiary img {
      transform: translateY(-34%);
    }

    .bear-showcase { min-height: min(112vw, 470px); }

    .bear-showcase-lockup {
      inset-block-start: 0;
      inset-inline-end: 1%;
      grid-template-columns: auto;
      gap: 0.12rem;
      font-size: 0.52rem;
      letter-spacing: 0.09em;
      text-align: end;
    }

    .bear-showcase-lockup i { display: none; }

    .bear-character-hero {
      inset-inline-start: -2%;
      width: 78%;
    }

    .bear-page .bear-phone-hero {
      inset-inline-end: 0;
      inset-block-end: 5%;
      width: min(34%, 175px);
      border-radius: 24px;
    }

    .bear-page .bear-phone-hero .phone-screen { border-radius: 18px; }

    .bear-page .commerce-section { padding-block: 4.8rem; }

    .bear-page .commerce-visual { min-height: min(108vw, 430px); }

