---
import SiteLayout from '../layouts/SiteLayout.astro';
import AccentHeading from './AccentHeading.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';
import { getCommerceCopy } from '../i18n/commerce';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const page = copy.bear;
const commerce = getCommerceCopy(locale);

const featureMedia = [
  {
    primary: '/products/bearagnostic/app-scan-depth.webp',
    secondary: '/products/bearagnostic/app-scan-progress.webp',
    secondaryKind: 'detail',
  },
  {
    primary: '/products/bearagnostic/app-scan-safe.webp',
    secondary: '/products/bearagnostic/app-cleanup-categories.webp',
    tertiary: '/products/bearagnostic/app-older-files.webp',
    secondaryKind: 'phone',
  },
  {
    primary: '/products/bearagnostic/app-tools.webp',
    secondary: '/products/bearagnostic/app-insights.webp',
    tertiary: '/products/bearagnostic/app-insights-trend.webp',
    secondaryKind: 'phone',
  },
] as const;

const stepIcons = ['spark', 'wallet', 'shield', 'unlock'] as const;
---

<SiteLayout title="Bearagnostic" description={page.metaDescription} locale={locale}>
  <div class="bear-page">
    <section class="bear-hero shell" aria-labelledby="bear-title">
      <div class="bear-hero-copy">
        <p class="section-label">{page.kicker}</p>
        <div class="product-status-row">
          <span class="status-pill">{copy.common.inDevelopment}</span>
          <span>Android</span>
        </div>

        <h1 id="bear-title" class="bear-title-wordmark" aria-label={page.title}>
          <span class="bear-title-dark">Bear</span><span class="bear-title-blue">agnostic</span>
        </h1>

        <p class="bear-promise">{page.promise}</p>
        <p class="bear-lead">{page.lead}</p>
        <a class="text-link bear-support-link" href={localizedPath(locale, '/support')}>
          {page.supportCta}<span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="bear-showcase" aria-label={page.title}>
        <div class="bear-showcase-lockup" aria-hidden="true">
          <span>DEVICE HEALTH</span>
          <i></i>
          <span>BETTER DAYS</span>
        </div>

        <figure class="bear-character-hero">
          <img
            src="/products/bearagnostic/dr-bear.png"
            alt="Dr. Bear giving a thumbs-up while holding a tablet"
            width="1254"
            height="1254"
            loading="eager"
            decoding="async"
          />
        </figure>

        <figure class="bear-phone-hero phone-card">
          <div class="phone-speaker" aria-hidden="true"></div>
          <div class="phone-screen">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="eager"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="bear-features" aria-labelledby="bear-features-title">
      <div class="shell">
        <p class="section-label">{page.featuresKicker}</p>
        <AccentHeading as="h2" id="bear-features-title" class="bear-section-title" text={page.featuresTitle} />

        <div class="feature-stories">
          {page.features.map((item, index) => {
            const media = featureMedia[index];
            return (
              <article class="feature-story">
                <div class="feature-story-copy">
                  <span class="feature-number">0{index + 1}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>

                <div class={`feature-story-visual feature-story-visual-${index + 1}`} aria-hidden="true">
                  <figure class="product-device device-primary">
                    <span class="device-speaker"></span>
                    <img src={media.primary} alt="" width="691" height="1536" loading="lazy" decoding="async" />
                  </figure>

                  <figure class:list={[
                    'device-secondary',
                    media.secondaryKind === 'detail' ? 'product-detail' : 'product-device'
                  ]}>
                    {media.secondaryKind === 'phone' && <span class="device-speaker"></span>}
                    <img
                      src={media.secondary}
                      alt=""
                      width="691"
                      height={media.secondaryKind === 'detail' ? '555' : '1536'}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>

                  {'tertiary' in media && media.tertiary && (
                    <figure class="product-detail device-tertiary">
                      <img
                        src={media.tertiary}
                        alt=""
                        width="691"
                        height={index === 1 ? '1115' : '1536'}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="pro-upgrade" aria-labelledby="pro-title">
      <div class="shell pro-upgrade-shell">
        <div class="pro-copy">
          <div class="pro-kicker-row">
            <p class="section-label">{page.proKicker}</p>
            <span class="pro-lifetime-pill">{commerce.lifetime}</span>
          </div>
          <AccentHeading as="h2" id="pro-title" class="commerce-title" text={page.proTitle} />
          <p class="pro-lead">{page.proBody}</p>

          <div class="pro-benefits" role="list">
            {page.proPoints.map((point) => (
              <div class="pro-benefit" role="listitem">
                <span class="pro-benefit-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="m5 12.5 4.2 4.2L19 7" /></svg>
                </span>
                <span>{point}</span>
              </div>
            ))}
          </div>

          <div class="pro-action-card" data-commerce-state="planned" aria-live="polite">
            <div class="pro-action-status">
              <span class="status-dot" aria-hidden="true"></span>
              <div>
                <strong>{page.proStatus}</strong>
                <span>{commerce.comingSoon}</span>
              </div>
            </div>
            <button class="pro-primary-button" type="button" disabled aria-disabled="true">
              <span>{commerce.upgradeCta}</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </button>
            <div class="pro-checkout-note">
              <span class="lock-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7.5 10V7.5a4.5 4.5 0 0 1 9 0V10M6 10h12v10H6z" /></svg>
              </span>
              <span>{commerce.secureCheckout}</span>
            </div>
            <p class="fine-note">{page.proNote}</p>
          </div>
        </div>

        <div class="pro-visual" aria-hidden="true">
          <div class="pro-visual-card">
            <div class="pro-card-topline">
              <span>BEARAGNOSTIC</span>
              <span class="pro-card-badge">PRO</span>
            </div>
            <div class="pro-card-glow"></div>
            <img
              src="/products/bearagnostic/dr-bear-warning.png"
              alt=""
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
            />
            <div class="pro-card-footer">
              <span class="pro-card-dot"></span>
              <span>{commerce.lifetime}</span>
            </div>
          </div>
          <span class="orbit-chip orbit-chip-one">Ko-fi</span>
          <span class="orbit-chip orbit-chip-two">AUTO</span>
          <span class="orbit-chip orbit-chip-three">PRO</span>
        </div>
      </div>
    </section>

    <section class="purchase-journey" aria-labelledby="how-pro-works">
      <div class="shell">
        <div class="journey-heading">
          <p class="section-label">{commerce.howKicker}</p>
          <h2 id="how-pro-works">{commerce.howTitle}</h2>
          <p>{commerce.howLead}</p>
        </div>

        <div class="journey-steps" role="list">
          {commerce.steps.map((step, index) => (
            <article class={`journey-step journey-step-${index + 1}`} role="listitem">
              <div class="journey-step-top">
                <span class={`journey-icon journey-icon-${stepIcons[index]}`} aria-hidden="true">
                  {stepIcons[index] === 'spark' && (
                    <svg viewBox="0 0 24 24"><path d="M12 3 14.2 9.8 21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z" /></svg>
                  )}
                  {stepIcons[index] === 'wallet' && (
                    <svg viewBox="0 0 24 24"><path d="M4 7.5h14a2 2 0 0 1 2 2v8.5H6a2 2 0 0 1-2-2zM4 8V6a2 2 0 0 1 2-2h11v3.5M15.5 12.5H20" /></svg>
                  )}
                  {stepIcons[index] === 'shield' && (
                    <svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 4.6-2.8 8-7 10-4.2-2-7-5.4-7-10V6zM8.5 12l2.2 2.2 4.8-5" /></svg>
                  )}
                  {stepIcons[index] === 'unlock' && (
                    <svg viewBox="0 0 24 24"><path d="M7 10V7.8A4.8 4.8 0 0 1 16.1 6M6 10h12v10H6zM12 14v2" /></svg>
                  )}
                </span>
                <span class="journey-number">0{index + 1}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>

        <div class="payment-method-note">
          <span class="payment-note-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 7h18v11H3zM3 10h18M7 15h3" /></svg>
          </span>
          <p>{commerce.methodsNote}</p>
        </div>

        <aside class="restore-strip" aria-labelledby="restore-pro-title">
          <div class="restore-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 11a8 8 0 1 1 2.1 5.4M4 5v6h6M9 12h6" /></svg>
          </div>
          <div class="restore-copy">
            <h3 id="restore-pro-title">{commerce.restoreTitle}</h3>
            <p>{commerce.restoreBody}</p>
          </div>
          <a class="restore-link" href={localizedPath(locale, '/support')}>
            {commerce.restoreCta}<span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .bear-page { overflow: clip; }

  .bear-page .bear-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(2.6rem, 6vw, 6rem);
    align-items: center;
    min-height: min(780px, calc(100svh - 76px));
    padding-block: clamp(4.4rem, 7vw, 6.8rem);
  }

  .bear-page .bear-hero-copy { min-width: 0; max-width: 560px; }

  .bear-page .product-status-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem;
    margin-block-end: 1rem; color: #53677f; font-size: 0.82rem; font-weight: 650;
  }

  .bear-title-wordmark {
    width: fit-content; max-width: 100%; margin: 0; overflow: visible; color: #071a39;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: clamp(3.25rem, 5vw, 5rem); font-weight: 800; letter-spacing: -0.062em;
    line-height: 0.96; white-space: nowrap;
  }
  .bear-title-dark { color: #071a39; }
  .bear-title-blue { color: #1688f3; }

  .bear-page .bear-promise {
    margin-block-start: 1.3rem; color: #1c5f9e; font-size: clamp(1.16rem, 1.55vw, 1.4rem);
    font-weight: 780; line-height: 1.42;
  }
  .bear-page .bear-lead { max-width: 540px; margin-block-start: 1.05rem; color: #667b95; line-height: 1.74; }
  .bear-page .bear-support-link { margin-block-start: 0.9rem; }

  .bear-showcase { position: relative; min-width: 0; min-height: clamp(500px, 41vw, 610px); isolation: isolate; }
  .bear-showcase::before {
    position: absolute; z-index: -2; inset: 8% 2% 2% 7%; border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%;
    background: radial-gradient(circle at 45% 45%, rgba(255,255,255,0.98), rgba(242,250,255,0.9) 48%, rgba(224,243,252,0.55) 70%, transparent 90%);
    content: ""; pointer-events: none;
  }
  .bear-showcase::after {
    position: absolute; z-index: -1; inset-inline-end: 10%; inset-block-end: 3%; width: 50%; height: 14%;
    border-radius: 50%; background: radial-gradient(ellipse, rgba(28, 76, 123, 0.10), transparent 70%);
    filter: blur(16px); content: ""; pointer-events: none;
  }
  .bear-showcase-lockup {
    position: absolute; z-index: 5; inset-block-start: 3%; inset-inline-end: 2%; display: grid;
    grid-template-columns: auto 28px auto; align-items: center; gap: 0.55rem; color: #657d98;
    font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em;
  }
  .bear-showcase-lockup i { display: block; width: 28px; height: 2px; border-radius: 999px; background: linear-gradient(90deg, #167bf2, #35c5de); }
  .bear-character-hero { position: absolute; z-index: 2; inset-inline-start: 1%; inset-block-end: 0; width: min(72%, 550px); margin: 0; }
  .bear-character-hero img { display: block; width: 100%; height: auto; object-fit: contain; image-rendering: auto; }
  .bear-page .bear-phone-hero {
    position: absolute; z-index: 4; inset-inline-end: 1%; inset-block-end: 5%; width: min(30%, 225px); margin: 0;
    padding: 6px; overflow: hidden; border: 1px solid rgba(20, 67, 114, 0.08); border-radius: 31px;
    background: #fff; box-shadow: 0 24px 65px rgba(28, 78, 129, 0.16); transform: rotate(1.4deg);
  }
  .bear-page .bear-phone-hero .phone-screen { overflow: hidden; border-radius: 24px; }
  .bear-page .bear-phone-hero img { width: 100%; height: auto; aspect-ratio: 691 / 1536; object-fit: cover; }

  .bear-page .bear-features {
    padding-block: clamp(5.2rem, 8vw, 7.2rem); border-block: 1px solid rgba(12, 47, 91, 0.07);
    background: radial-gradient(circle at 92% 12%, rgba(83, 196, 222, 0.09), transparent 25rem), linear-gradient(180deg, rgba(248, 252, 255, 0.82), rgba(255, 255, 255, 0.98));
  }
  :global(.bear-section-title) { max-width: 820px; font-size: clamp(3rem, 5vw, 5rem); line-height: 1.01; letter-spacing: var(--type-heading-tracking, -0.045em); }
  .feature-stories { display: grid; gap: clamp(1.5rem, 3vw, 2.3rem); margin-block-start: clamp(3rem, 5vw, 4.8rem); }
  .feature-story {
    display: grid; grid-template-columns: minmax(0, 0.78fr) minmax(430px, 1.22fr); gap: clamp(2rem, 5vw, 5rem);
    align-items: center; min-height: 650px; padding: clamp(1.45rem, 3vw, 2.5rem); overflow: hidden;
    border: 1px solid rgba(17, 60, 103, 0.08); border-radius: 38px;
    background: radial-gradient(circle at 82% 14%, rgba(43, 114, 246, 0.08), transparent 24rem), rgba(255, 255, 255, 0.88);
    box-shadow: 0 22px 64px rgba(31, 48, 72, 0.08);
  }
  .feature-story:nth-child(2) { background: radial-gradient(circle at 18% 18%, rgba(122, 115, 230, 0.08), transparent 23rem), rgba(255, 255, 255, 0.9); }
  .feature-story:nth-child(3) { background: radial-gradient(circle at 82% 18%, rgba(72, 173, 121, 0.08), transparent 23rem), rgba(255, 255, 255, 0.9); }
  .feature-story:nth-child(even) .feature-story-copy { order: 2; }
  .feature-story:nth-child(even) .feature-story-visual { order: 1; }
  .feature-story-copy { min-width: 0; max-width: 490px; }
  .feature-number {
    display: grid; width: 44px; height: 44px; place-items: center; color: #176fc9; border: 1px solid rgba(43, 114, 246, 0.1);
    border-radius: 15px; background: rgba(43, 114, 246, 0.07); font-size: 0.76rem; font-weight: 850; letter-spacing: 0.1em;
  }
  .feature-story-copy h3 { margin-block-start: 1.2rem; font-size: clamp(2rem, 3.3vw, 3.15rem); line-height: 1.02; }
  .feature-story-copy p { margin-block-start: 1rem; color: #667b95; font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: var(--type-body-leading, 1.72); }
  .feature-story-visual { position: relative; min-width: 0; min-height: 570px; isolation: isolate; }
  .feature-story-visual::before {
    position: absolute; z-index: -1; inset: 7% 4% 4%; border-radius: 42px;
    background: radial-gradient(circle at 48% 42%, rgba(255,255,255,0.98), rgba(236,247,255,0.78) 52%, rgba(224,242,252,0.36) 74%, transparent);
    content: "";
  }
  .product-device, .product-detail { position: absolute; margin: 0; overflow: hidden; border: 1px solid rgba(22, 67, 111, 0.09); background: #fff; box-shadow: 0 24px 65px rgba(28, 78, 129, 0.15); }
  .product-device { padding: 6px; border-radius: 31px; }
  .product-device img { display: block; width: 100%; height: auto; border-radius: 24px; }
  .product-detail { border-radius: 24px; }
  .product-detail img { display: block; width: 100%; height: auto; }
  .device-speaker { position: absolute; z-index: 2; inset-block-start: 10px; inset-inline-start: 50%; width: 24%; height: 5px; border-radius: 999px; background: rgba(20, 42, 70, 0.1); transform: translateX(-50%); }
  .feature-story-visual-1 .device-primary { inset-inline-start: 7%; inset-block-start: 3%; width: min(47%, 255px); transform: rotate(-3.2deg); }
  .feature-story-visual-1 .device-secondary { inset-inline-end: 3%; inset-block-end: 9%; width: min(63%, 365px); transform: rotate(2deg); }
  .feature-story-visual-2 .device-primary { inset-inline-start: 3%; inset-block-start: 2%; width: min(43%, 245px); transform: rotate(-4deg); }
  .feature-story-visual-2 .device-secondary { inset-inline-end: 4%; inset-block-start: 12%; width: min(42%, 235px); transform: rotate(4deg); }
  .feature-story-visual-2 .device-tertiary { z-index: 4; inset-inline-start: 23%; inset-block-end: 0; width: min(55%, 330px); }
  .feature-story-visual-3 .device-primary { inset-inline-start: 4%; inset-block-start: 2%; width: min(42%, 240px); transform: rotate(-3deg); }
  .feature-story-visual-3 .device-secondary { inset-inline-end: 4%; inset-block-start: 9%; width: min(42%, 235px); transform: rotate(3.5deg); }
  .feature-story-visual-3 .device-tertiary { z-index: 4; inset-inline-start: 24%; inset-block-end: 0; width: min(53%, 320px); max-height: 245px; }
  .feature-story-visual-3 .device-tertiary img { transform: translateY(-42%); }

  /* Pro upgrade — bright, premium, purchase-ready while commerce remains fail-closed. */
  .pro-upgrade {
    position: relative; padding-block: clamp(5.4rem, 8vw, 8rem); overflow: hidden;
    background:
      radial-gradient(circle at 12% 8%, rgba(68, 203, 238, 0.16), transparent 28rem),
      radial-gradient(circle at 88% 76%, rgba(255, 191, 94, 0.14), transparent 27rem),
      linear-gradient(180deg, #fbfdff 0%, #f4faff 54%, #fffaf3 100%);
    border-block-end: 1px solid rgba(12, 47, 91, 0.07);
  }
  .pro-upgrade::before {
    position: absolute; inset: 0; pointer-events: none; content: ""; opacity: 0.46;
    background-image: radial-gradient(circle at center, rgba(29, 119, 229, 0.12) 1px, transparent 1.2px);
    background-size: 28px 28px; mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 76%, transparent);
  }
  .pro-upgrade-shell { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(390px, 0.78fr); gap: clamp(3rem, 7vw, 7.2rem); align-items: center; }
  .pro-copy { min-width: 0; max-width: 760px; }
  .pro-kicker-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1rem; }
  .pro-kicker-row .section-label { margin: 0; }
  .pro-lifetime-pill {
    display: inline-flex; align-items: center; min-height: 31px; padding-inline: 0.82rem; border-radius: 999px;
    color: #7a4b06; border: 1px solid rgba(214, 143, 36, 0.18); background: rgba(255, 244, 217, 0.9);
    font-size: 0.74rem; font-weight: 820; letter-spacing: 0.02em;
  }
  :global(.commerce-title) { max-width: 760px; margin-block-start: 0.75rem; font-size: clamp(3rem, 5vw, 5rem); line-height: 1.02; letter-spacing: var(--type-heading-tracking, -0.045em); }
  .pro-lead { max-width: 670px; margin-block-start: 1.25rem; color: #5e738d; font-size: clamp(1rem, 1.18vw, 1.12rem); line-height: var(--type-body-leading, 1.72); }
  .pro-benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin-block-start: 1.6rem; }
  .pro-benefit {
    display: grid; grid-template-columns: 30px minmax(0,1fr); gap: 0.62rem; align-items: start; min-width: 0;
    padding: 0.9rem 0.9rem 1rem; border: 1px solid rgba(23, 102, 185, 0.09); border-radius: 20px; background: rgba(255,255,255,0.78);
    box-shadow: 0 12px 32px rgba(35, 84, 132, 0.05); color: #294967; font-size: 0.86rem; font-weight: 680; line-height: 1.45;
  }
  .pro-benefit-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 10px; color: #1978d7; background: #eaf5ff; }
  .pro-benefit-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
  .pro-action-card {
    margin-block-start: 1rem; padding: clamp(1rem, 1.8vw, 1.25rem); border: 1px solid rgba(23, 92, 155, 0.1); border-radius: 24px;
    background: rgba(255,255,255,0.88); box-shadow: 0 20px 48px rgba(35, 84, 132, 0.07); backdrop-filter: blur(8px);
  }
  .pro-action-status { display: flex; align-items: center; gap: 0.75rem; }
  .pro-action-status .status-dot { flex: 0 0 auto; }
  .pro-action-status div { display: grid; gap: 0.12rem; }
  .pro-action-status strong { color: #153d67; font-size: 0.92rem; }
  .pro-action-status div span { color: #72849a; font-size: 0.76rem; }
  .pro-primary-button {
    display: flex; width: 100%; min-height: 54px; align-items: center; justify-content: space-between; gap: 1rem; margin-block-start: 1rem;
    padding-inline: 1.15rem; border: 0; border-radius: 16px; color: rgba(255,255,255,0.94);
    background: linear-gradient(135deg, #247ee9, #19acd8); box-shadow: 0 12px 28px rgba(36,126,233,0.18);
    font: inherit; font-weight: 820; cursor: not-allowed; opacity: 0.66;
  }
  .button-arrow { font-size: 1.2rem; }
  .pro-checkout-note { display: flex; align-items: center; gap: 0.45rem; margin-block-start: 0.75rem; color: #53708d; font-size: 0.78rem; font-weight: 650; }
  .lock-icon { display: grid; width: 22px; height: 22px; place-items: center; color: #278465; }
  .lock-icon svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .pro-action-card .fine-note { margin-block-start: 0.65rem; color: #7a8ba0; font-size: 0.78rem; line-height: 1.55; }

  .pro-visual { position: relative; min-height: 560px; isolation: isolate; }
