---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const page = copy.support;
const products = copy.products;
---

<SiteLayout title={copy.nav.support} description={page.metaDescription} locale={locale}>
  <div class="support-page">
    <section class="support-hero shell">
      <p class="section-label">{page.kicker}</p>
      <h1 class="premium-tone-heading">{page.title}</h1>
      <p>{page.lead}</p>
    </section>

    <section class="support-grid shell" aria-label={copy.nav.support}>
      <article class="support-card support-bear">
        <div class="support-bear-visual" aria-hidden="true">
          <span class="bear-halo"></span>
          <img
            src="/products/bearagnostic/dr-bear-inspecting.png"
            alt=""
            width="1536"
            height="1477"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="support-card-copy">
          <p class="section-label">Android</p>
          <h2>{page.bearTitle}</h2>
          <p>{page.bearBody}</p>
          <a class="text-link" href={localizedPath(locale, '/products/bearagnostic')}>
            {copy.common.viewProduct}<span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="support-card support-benedict">
        <div class="support-brand-visual" aria-hidden="true">
          <span class="brand-halo"></span>
          <img src="/brand/benedict-mark.png" alt="" width="609" height="754" loading="lazy" decoding="async" />
        </div>

        <div class="support-card-copy">
          <h2>{page.generalTitle}</h2>
          <p>{page.generalBody}</p>
        </div>
      </article>

      <article class="support-card support-test-center" id="tester-program">
        <div class="test-center-brand" aria-hidden="true">
          <span class="test-center-halo"></span>
          <img src="/brand/benedict-mark.png" alt="" width="609" height="754" loading="lazy" decoding="async" />
        </div>

        <div class="support-card-copy">
          <div class="test-center-meta">
            <span class="status-pill status-muted">{copy.common.planned}</span>
            <span class="section-label">{products.testKicker}</span>
          </div>
          <h2>{products.testTitle}</h2>
          <p>{products.testDescription}</p>
          <p class="fine-note">{products.testNote}</p>
        </div>
      </article>
    </section>

    <aside class="staging-note shell">
      <span class="status-dot" aria-hidden="true"></span>
      <p>{page.stagingNote}</p>
    </aside>
  </div>
</SiteLayout>

<style>
  .support-page {
    overflow: clip;
  }

  .support-hero {
    width: min(calc(100% - clamp(2rem, 6vw, 5rem)), 1040px);
    padding-block: clamp(4.6rem, 7.5vw, 6.8rem) clamp(2.8rem, 4.6vw, 4rem);
    text-align: center;
  }

  .support-hero h1 {
    max-width: 14ch;
    margin-inline: auto;
    font-size: clamp(3.15rem, 5.4vw, 4.9rem);
    line-height: 1.015;
    letter-spacing: var(--type-heading-tracking, -0.045em);
    text-wrap: balance;
  }

  .support-hero > p:last-child {
    max-width: 760px;
    margin: 1.25rem auto 0;
    color: #667b95;
    font-size: clamp(1rem, 1.35vw, 1.13rem);
    line-height: var(--type-body-leading, 1.72);
  }

  .premium-tone-heading {
    color: #10213a;
    background: linear-gradient(112deg, #10213a 0%, #10213a 47%, #146fd9 72%, #35b7df 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.45rem);
    padding-block-end: 1.3rem;
  }

  .support-card {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 330px;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    overflow: hidden;
    border: 1px solid rgba(14, 54, 96, 0.07);
    border-radius: clamp(28px, 3vw, 38px);
    background: rgba(255, 255, 255, 0.91);
    box-shadow: 0 22px 62px rgba(31, 89, 147, 0.07);
  }

  .support-bear {
    grid-template-columns: minmax(145px, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.4rem, 2.6vw, 2.2rem);
    align-items: center;
    background:
      radial-gradient(circle at 8% 22%, rgba(42, 186, 241, 0.08), transparent 14rem),
      rgba(255, 255, 255, 0.91);
  }

  .support-bear-visual,
  .support-brand-visual,
  .test-center-brand {
    position: relative;
    display: grid;
    min-width: 0;
    place-items: center;
    isolation: isolate;
  }

  .bear-halo,
  .brand-halo,
  .test-center-halo {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .bear-halo {
    inset: 16% 5% 12%;
    background: radial-gradient(circle, rgba(42, 186, 241, 0.13), transparent 70%);
  }

  .support-bear-visual img {
    width: min(100%, 196px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 28px rgba(31, 74, 115, 0.08));
  }

  .support-benedict {
    grid-template-columns: minmax(118px, 0.28fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    background:
      radial-gradient(circle at 13% 32%, rgba(42, 186, 241, 0.075), transparent 13rem),
      rgba(255, 255, 255, 0.91);
  }

  .support-brand-visual {
    min-height: 180px;
  }

  .brand-halo {
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(42, 186, 241, 0.14), transparent 70%);
  }

  .support-brand-visual img {
    width: clamp(90px, 9vw, 124px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(31, 89, 147, 0.11));
  }

  .support-card-copy {
    min-width: 0;
  }

  .support-card h2 {
    max-width: 100%;
    margin: 0;
    font-size: clamp(1.9rem, 2.8vw, 2.65rem);
    line-height: var(--type-heading-leading, 1.08);
    letter-spacing: var(--type-heading-tracking, -0.035em);
    text-wrap: balance;
  }

  .support-card p:not(.section-label, .fine-note) {
    margin-block-start: 0.9rem;
    color: #687c94;
    line-height: var(--type-body-leading, 1.72);
  }

  .support-card .text-link {
    margin-block-start: 1.15rem;
  }

  .support-test-center {
    grid-column: 1 / -1;
    grid-template-columns: minmax(170px, 0.28fr) minmax(0, 1fr);
    gap: clamp(1.8rem, 4vw, 3.6rem);
    align-items: center;
    min-height: 285px;
    background:
      radial-gradient(circle at 9% 50%, rgba(88, 172, 235, 0.10), transparent 16rem),
      linear-gradient(135deg, rgba(255,255,255,.97), rgba(247,250,255,.95));
  }

  .test-center-brand {
    min-height: 180px;
  }

  .test-center-halo {
    width: 170px;
    height: 170px;
    background: radial-gradient(circle, rgba(42, 186, 241, 0.14), rgba(122, 115, 230, 0.035) 52%, transparent 72%);
  }

  .test-center-brand img {
    width: clamp(108px, 11vw, 145px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 30px rgba(34, 96, 151, 0.11));
  }

  .test-center-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 0.9rem;
    align-items: center;
    margin-block-end: 0.8rem;
  }

  .test-center-meta .section-label {
    margin: 0;
  }

  .support-test-center .fine-note {
    max-width: 760px;
    margin-block-start: 0.75rem;
  }

  .support-page .staging-note {
    margin-block: 0.4rem clamp(4.5rem, 7vw, 6.5rem);
  }

  @media (max-width: 920px) {
    .support-grid {
      grid-template-columns: 1fr;
    }

    .support-test-center {
      grid-column: auto;
    }
  }

  @media (max-width: 680px) {
    .support-hero {
      padding-block: 3.4rem 2.5rem;
    }

    .support-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.65rem, 11.8vw, 3.9rem);
      line-height: 1.045;
    }

    .support-card {
      min-height: 0;
      padding: 1.3rem;
      border-radius: 27px;
    }

    .support-bear {
      grid-template-columns: 108px minmax(0, 1fr);
      gap: 1rem;
    }

    .support-bear-visual img {
      width: 116px;
    }

    .support-benedict,
    .support-test-center {
      grid-template-columns: 116px minmax(0, 1fr);
      gap: 1rem;
    }

    .support-brand-visual,
    .test-center-brand {
      min-height: 118px;
    }

    .support-brand-visual img,
    .test-center-brand img {
      width: 92px;
    }

    .support-card h2 {
      font-size: clamp(1.62rem, 7vw, 2.15rem);
    }
  }

  @media (max-width: 460px) {
    .support-bear,
    .support-benedict,
    .support-test-center {
      grid-template-columns: 1fr;
    }

    .support-bear-visual,
    .support-brand-visual,
    .test-center-brand {
      min-height: 122px;
      place-items: center start;
    }

    .support-bear-visual img { width: 138px; }
    .support-brand-visual img,
    .test-center-brand img { width: 98px; }

    .brand-halo,
    .test-center-halo {
      inset-inline-start: -26px;
      width: 145px;
      height: 145px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .support-bear-visual img,
    .support-brand-visual img,
    .test-center-brand img {
      transition: transform 240ms cubic-bezier(.2,.7,.2,1);
    }

    .support-bear:hover .support-bear-visual img,
    .support-benedict:hover .support-brand-visual img,
    .support-test-center:hover .test-center-brand img {
      transform: translateY(-4px);
    }
  }
</style>
