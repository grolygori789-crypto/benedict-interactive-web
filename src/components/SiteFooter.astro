---
import { site } from '../data/site';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand-block">
      <a class="footer-brand" href={localizedPath(locale, '/')}>{site.name}</a>
      <p>{copy.common.footerLine}</p>
    </div>

    <nav class="footer-links" aria-label={copy.nav.menu}>
      <a href={localizedPath(locale, '/products')}>{copy.nav.products}</a>
      <a href={localizedPath(locale, '/support')}>{copy.nav.support}</a>
      <a href={`https://github.com/${site.repository}`} rel="noopener noreferrer">GitHub</a>
    </nav>

    <div class="footer-meta">
      <span class="staging-dot" aria-hidden="true"></span>
      <span>{copy.common.footerStaging}</span>
      <small>© {year} Benedict Interactive</small>
    </div>
  </div>
</footer>
