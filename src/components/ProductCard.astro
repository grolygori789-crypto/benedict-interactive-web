---
interface Props {
  name: string;
  eyebrow: string;
  description: string;
  promise: string;
  href: string;
  status: string;
  accent?: 'blue' | 'violet' | 'amber' | 'green';
}

const {
  name,
  eyebrow,
  description,
  promise,
  href,
  status,
  accent = 'blue',
} = Astro.props;
---

<article class={`product-card accent-${accent}`}>
  <div class="product-card-top">
    <span class="product-orb" aria-hidden="true"></span>
    <span class="status-pill">{status}</span>
  </div>
  <p class="eyebrow">{eyebrow}</p>
  <h3>{name}</h3>
  <p class="product-description">{description}</p>
  <p class="product-promise">{promise}</p>
  <a class="text-link" href={href}>View product <span aria-hidden="true">→</span></a>
</article>
