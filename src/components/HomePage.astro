---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <section class="home-hero shell" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="section-label">{home.kicker}</p>
      <h1 id="home-title">
        <span>{home.headlineA}</span>
        <strong>{home.headlineB}</strong>
      </h1>
      <p class="hero-lead">{home.lead}</p>

      <div class="hero-actions">
        <a class="button button-primary" href="#bearagnostic">
          {home.primaryCta}<span aria-hidden="true">→</span>
        </a>
        <a class="button button-quiet" href="#philosophy">{home.secondaryCta}</a>
      </div>

      <div class="trust-line" aria-label={home.kicker}>
        {home.proof.map((item, index) => (
          <span><i class={`trust-dot trust-dot-${index + 1}`} aria-hidden="true"></i>{item}</span>
        ))}
      </div>
    </div>

    <figure class="founder-scene">
      <div class="founder-aura" aria-hidden="true"></div>
      <div class="founder-pixel founder-pixel-a" aria-hidden="true"></div>
      <div class="founder-pixel founder-pixel-b" aria-hidden="true"></div>
      <img
        class="founder-cutout"
        src="/brand/benedict-j.webp"
        alt="Benedict J."
        width="1440"
        height="810"
        loading="eager"
        decoding="async"
      />
      <figcaption class="founder-caption">
        <span>
          <strong>Benedict J.</strong>
          <small>{home.founderRole}</small>
        </span>
        <em>{home.founderNote}</em>
      </figcaption>
    </figure>
  </section>

  <section class="philosophy-band" id="philosophy" aria-labelledby="philosophy-title">
    <div class="shell philosophy-grid">
      <div>
        <p class="section-label">{home.philosophyKicker}</p>
        <h2 id="philosophy-title">{home.philosophyTitle}</h2>
      </div>
      <p>{home.philosophyBody}</p>
    </div>
  </section>

  <section class="product-feature shell" id="bearagnostic" aria-labelledby="bearagnostic-title">
    <div class="product-copy">
      <p class="section-label">{home.productKicker}</p>
      <div class="product-status-row">
        <span class="status-pill">{copy.common.inDevelopment}</span>
        <span>Android</span>
      </div>
      <h2 id="bearagnostic-title">{home.productTitle}</h2>
      <p class="product-promise">{home.productPromise}</p>
      <p class="product-body">{home.productBody}</p>

      <div class="quality-list" aria-label="Bearagnostic qualities">
        {home.productTags.map((tag, index) => (
          <span><i aria-hidden="true">0{index + 1}</i>{tag}</span>
        ))}
      </div>

      <div class="product-actions">
        <a class="button button-primary" href={localizedPath(locale, '/products/bearagnostic')}>
          {home.productCta}<span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={localizedPath(locale, '/support')}>
          {home.productSupport}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="product-theatre" aria-label={home.productTitle}>
      <div class="product-theatre-header">
        <div class="bear-wordmark" aria-label="Bearagnostic">
          <strong>Bear</strong><span>agnostic</span>
        </div>
        <p>DEVICE HEALTH <i aria-hidden="true"></i> BETTER DAYS</p>
      </div>

      <figure class="dr-bear-figure">
        <img
          src="/products/bearagnostic/dr-bear.png"
          alt="Dr. Bear, the Bearagnostic mascot, giving a thumbs-up while holding a tablet"
          width="1478"
          height="1536"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="phone-card">
        <div class="phone-speaker" aria-hidden="true"></div>
        <div class="phone-screen">
          <img
            src="/products/bearagnostic/app-home.webp"
            alt="Bearagnostic home screen"
            width="691"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>{home.realScreen}</figcaption>
      </figure>

      <div class="product-orbit product-orbit-a" aria-hidden="true"></div>
      <div class="product-orbit product-orbit-b" aria-hidden="true"></div>
    </div>
  </section>

  <section class="principles-section" aria-labelledby="principles-title">
    <div class="shell">
      <div class="principles-heading">
        <div>
          <p class="section-label">{home.principlesKicker}</p>
          <h2 id="principles-title">{home.principlesTitle}</h2>
        </div>
        <p>{home.principlesIntro}</p>
      </div>

      <div class="principle-grid">
        {home.principles.map((item, index) => (
          <article class="principle-item">
            <span class={`principle-icon principle-icon-${index + 1}`} aria-hidden="true"></span>
            <span class="principle-number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="studio-section shell" aria-labelledby="studio-title">
    <div class="studio-rule" aria-hidden="true"></div>
    <div class="studio-mark" aria-hidden="true">
      <img src="/brand/benedict-mark.png" alt="" width="609" height="754" loading="lazy" />
    </div>
    <div class="studio-copy">
      <p class="section-label">{home.studioKicker}</p>
      <h2 id="studio-title">{home.studioTitle}</h2>
      <p>{home.studioBody}</p>
    </div>
    <blockquote>
      <p>“{home.studioQuote}”</p>
      <footer>— Benedict J.</footer>
    </blockquote>
  </section>

  <section class="closing-section shell" aria-labelledby="closing-title">
    <div class="closing-badge" aria-hidden="true">
      <img src="/brand/benedict-mark.png" alt="" width="609" height="754" loading="lazy" />
    </div>
    <div class="closing-copy">
      <p class="section-label">{home.closingKicker}</p>
      <h2 id="closing-title">{home.closingTitle}</h2>
      <p>{home.closingBody}</p>
      <a class="button button-light" href={localizedPath(locale, '/products')}>
        {home.closingCta}<span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="closing-spark closing-spark-a" aria-hidden="true"></div>
    <div class="closing-spark closing-spark-b" aria-hidden="true"></div>
  </section>
</SiteLayout>
