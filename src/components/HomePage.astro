---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
const bear = copy.bear;

const heroA = locale === 'en' ? 'Bright software for' : home.headlineA;
const heroB = locale === 'en' ? 'calmer digital lives.' : home.headlineB;
const heroLead = locale === 'en'
  ? 'Thoughtful software for a cleaner, simpler, brighter everyday.'
  : home.lead;
const heroNote = locale === 'en' ? 'Better tools. Brighter days.' : home.founderNote;
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <div class="bi-home">
    <section class="bi-hero bi-shell" aria-labelledby="home-title">
      <div class="bi-hero-copy">
        <p class="bi-kicker">{home.kicker}</p>
        <h1 id="home-title">
          <span>{heroA}</span>
          <strong>{heroB}</strong>
        </h1>
        <p class="bi-hero-lead">{heroLead}</p>
        <div class="bi-actions">
          <a class="bi-button bi-button-primary" href="#bearagnostic">
            {home.primaryCta}<span aria-hidden="true">→</span>
          </a>
          <a class="bi-button bi-button-secondary" href="#philosophy">
            {home.secondaryCta}
          </a>
        </div>
      </div>

      <figure class="bi-founder">
        <div class="bi-founder-glow" aria-hidden="true"></div>
        <img
          src="/brand/benedict-j.webp"
          alt="Benedict J. at his desk with a laptop and a sleeping dog"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
        />
        <figcaption class="bi-founder-note">
          <span>{heroNote}</span>
          <strong>Benedict J.</strong>
        </figcaption>
      </figure>
    </section>

    <section class="bi-product-wrap" id="bearagnostic" aria-labelledby="bearagnostic-title">
      <div class="bi-product bi-shell">
        <div class="bi-product-copy">
          <p class="bi-kicker">{home.productKicker}</p>
          <h2 id="bearagnostic-title">{home.productTitle}</h2>
          <p class="bi-product-promise">{home.productPromise}</p>
          <p class="bi-product-body">{home.productBody}</p>

          <div class="bi-actions bi-product-actions">
            <a class="bi-button bi-button-primary" href={localizedPath(locale, '/products/bearagnostic')}>
              {home.productCta}<span aria-hidden="true">→</span>
            </a>
            <a class="bi-link" href={localizedPath(locale, '/support')}>
              {home.productSupport}<span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="bi-product-gallery" aria-label={home.productTitle}>
          <figure class="bi-screen bi-screen-scan">
            <img
              src="/products/bearagnostic/app-scan-safe.webp"
              alt="Bearagnostic scanning files locally on device"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{home.realScreen}</figcaption>
          </figure>
          <figure class="bi-screen bi-screen-home">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure class="bi-screen bi-screen-insights">
            <img
              src="/products/bearagnostic/app-insights.webp"
              alt="Bearagnostic insights screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>

      <div class="bi-benefits bi-shell" aria-label={home.productTitle}>
        {bear.features.map((item, index) => (
          <article>
            <span class:list={["bi-benefit-icon", `bi-benefit-icon-${index + 1}`]} aria-hidden="true">
              {index === 0 ? '✦' : index === 1 ? '◇' : '⌁'}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bi-philosophy bi-shell" id="philosophy" aria-labelledby="philosophy-title">
      <div class="bi-philosophy-title">
        <p class="bi-kicker">{home.philosophyKicker}</p>
        <h2 id="philosophy-title">{home.philosophyTitle}</h2>
      </div>
      <div class="bi-principles">
        {home.principles.map((item, index) => (
          <article>
            <span aria-hidden="true">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .bi-home {
    overflow: clip;
    color: #10213a;
    background:
      radial-gradient(circle at 82% 7%, rgba(76, 196, 234, 0.13), transparent 25rem),
      radial-gradient(circle at 12% 20%, rgba(45, 126, 246, 0.06), transparent 28rem),
      #f8fbff;
  }

  .bi-shell {
    width: min(calc(100% - 3rem), 1240px);
    margin-inline: auto;
  }

  .bi-kicker {
    margin: 0 0 1rem;
    color: #3d7eb8;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .bi-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(520px, 1.12fr);
    gap: clamp(2.4rem, 5vw, 5rem);
    align-items: center;
    min-height: clamp(610px, 72vh, 760px);
    padding-block: clamp(3.2rem, 6vw, 6rem);
  }

  .bi-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 590px;
  }

  .bi-hero h1,
  .bi-product h2,
  .bi-philosophy h2 {
    margin: 0;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .bi-hero h1 {
    font-size: clamp(3.7rem, 6vw, 6.2rem);
    line-height: 0.94;
  }

  .bi-hero h1 span,
  .bi-hero h1 strong {
    display: block;
  }

  .bi-hero h1 strong {
    color: #1c7ff2;
    font-weight: inherit;
    background: linear-gradient(105deg, #185ecf 0%, #1e87f7 55%, #48c6de 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bi-hero-lead {
    max-width: 530px;
    margin: 1.45rem 0 0;
    color: #63758c;
    font-size: clamp(1.02rem, 1.45vw, 1.24rem);
    line-height: 1.65;
  }

  .bi-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.8rem;
  }

  .bi-button,
  .bi-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 760;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .bi-button {
    padding-inline: 1.2rem;
  }

  .bi-button:hover,
  .bi-link:hover {
    transform: translateY(-1px);
  }

  .bi-button-primary {
    color: #fff;
    background: linear-gradient(135deg, #087ff0, #22a8f5);
    box-shadow: 0 14px 32px rgba(17, 129, 235, 0.22);
  }

  .bi-button-secondary {
    color: #1d5f9f;
    border: 1px solid #c8dded;
    background: rgba(255, 255, 255, 0.82);
  }

  .bi-link {
    min-height: 44px;
    padding-inline: 0.3rem;
    color: #2d6fae;
  }

  .bi-founder {
    position: relative;
    min-height: clamp(460px, 38vw, 585px);
    margin: 0;
    isolation: isolate;
  }

  .bi-founder-glow {
    position: absolute;
    z-index: -1;
    inset: 9% 4% 8% 16%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 195, 226, 0.24), rgba(83, 195, 226, 0));
    filter: blur(24px);
  }

  .bi-founder img {
    position: absolute;
    inset-inline-end: -4%;
    inset-block-end: 0;
    width: 112%;
    max-width: none;
    height: auto;
  }

  .bi-founder::after {
    position: absolute;
    inset-inline: 6% 0;
    inset-block-end: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(85, 135, 179, 0.22), transparent);
    content: "";
  }

  .bi-founder-note {
    position: absolute;
    z-index: 2;
    inset-inline-end: 2%;
    inset-block-start: 8%;
    display: grid;
    gap: 0.35rem;
    max-width: 175px;
    color: #2c85e8;
    transform: rotate(-4deg);
    text-align: center;
  }

  .bi-founder-note span {
    font-family: "Segoe Print", "Bradley Hand", cursive;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.2;
  }

  .bi-founder-note strong {
    color: #284b72;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.82rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .bi-product-wrap {
    padding-block: clamp(4.6rem, 7vw, 7rem);
    border-block: 1px solid rgba(28, 54, 84, 0.07);
    background:
      radial-gradient(circle at 70% 30%, rgba(59, 190, 228, 0.12), transparent 34rem),
      linear-gradient(180deg, rgba(255,255,255,0.82), rgba(244,249,253,0.96));
  }

  .bi-product {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(580px, 1.32fr);
    gap: clamp(2.5rem, 5.5vw, 5.4rem);
    align-items: center;
  }

  .bi-product-copy {
    max-width: 480px;
  }

  .bi-product h2 {
    font-size: clamp(3rem, 5.2vw, 5.2rem);
    line-height: 0.98;
  }

  .bi-product-promise {
    margin: 1.15rem 0 0;
    color: #234d78;
    font-size: clamp(1.12rem, 1.7vw, 1.42rem);
    font-weight: 760;
    line-height: 1.38;
  }

  .bi-product-body {
    margin: 1rem 0 0;
    color: #65788e;
    line-height: 1.72;
  }

  .bi-product-gallery {
    position: relative;
    min-height: 610px;
  }

  .bi-screen {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(18, 40, 65, 0.08);
    border-radius: 32px;
    background: #fff;
    box-shadow: 0 28px 70px rgba(29, 63, 102, 0.14);
  }

  .bi-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .bi-screen figcaption {
    position: absolute;
    inset-inline-start: 0.8rem;
    inset-block-end: 0.8rem;
    padding: 0.45rem 0.68rem;
    color: #214e79;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(10px);
    font-size: 0.65rem;
    font-weight: 780;
  }

  .bi-screen-scan {
    z-index: 3;
    inset-inline-start: 22%;
    inset-block-start: 1%;
    width: 42%;
    transform: rotate(-1.2deg);
  }

  .bi-screen-home {
    z-index: 2;
    inset-inline-end: 0;
    inset-block-start: 10%;
    width: 35%;
    transform: rotate(1.4deg);
  }

  .bi-screen-insights {
    z-index: 1;
    inset-inline-start: 2%;
    inset-block-start: 17%;
    width: 31%;
    transform: rotate(-2deg);
    opacity: 0.98;
  }

  .bi-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    margin-top: clamp(2.8rem, 5vw, 4rem);
  }

  .bi-benefits article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgba(26, 58, 91, 0.08);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 16px 38px rgba(39, 78, 118, 0.05);
  }

  .bi-benefit-icon {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 15px;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .bi-benefit-icon-1 { color: #087de6; background: #e5f4ff; }
  .bi-benefit-icon-2 { color: #7b5de9; background: #f0ecff; }
  .bi-benefit-icon-3 { color: #17a879; background: #e5fbf4; }

  .bi-benefits h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .bi-benefits p {
    margin: 0.35rem 0 0;
    color: #718196;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .bi-philosophy {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(4.2rem, 7vw, 6rem);
  }

  .bi-philosophy h2 {
    max-width: 430px;
    font-size: clamp(2.2rem, 4vw, 3.9rem);
    line-height: 1.02;
  }

  .bi-principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .bi-principles article {
    padding-inline-start: 1.15rem;
    border-inline-start: 1px solid #d9e6f0;
  }

  .bi-principles span {
    color: #2980d8;
    font-size: 0.7rem;
    font-weight: 820;
    letter-spacing: 0.12em;
  }

  .bi-principles h3 {
    margin: 0.95rem 0 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .bi-principles p {
    margin: 0.5rem 0 0;
    color: #718196;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 1120px) {
    .bi-hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr);
      gap: 2.2rem;
    }

    .bi-product {
      grid-template-columns: minmax(0, 0.75fr) minmax(500px, 1.25fr);
      gap: 2.5rem;
    }

    .bi-product-gallery {
      min-height: 560px;
    }
  }

  @media (max-width: 940px) {
    .bi-shell {
      width: min(calc(100% - 2rem), 900px);
    }

    .bi-hero {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      min-height: 0;
      padding-block: 3.5rem 2.4rem;
    }

    .bi-hero-copy {
      max-width: 720px;
    }

    .bi-hero h1 {
      max-width: 760px;
      font-size: clamp(3.4rem, 8vw, 5.2rem);
    }

    .bi-founder {
      min-height: 460px;
    }

    .bi-founder img {
      width: 102%;
      inset-inline-end: -2%;
    }

    .bi-founder-note {
      inset-inline-end: 5%;
      inset-block-start: 7%;
    }

    .bi-product {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .bi-product-copy {
      max-width: 700px;
    }

    .bi-product-gallery {
      width: min(100%, 720px);
      min-height: 590px;
      margin-inline: auto;
    }

    .bi-benefits {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .bi-philosophy {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }

  @media (max-width: 680px) {
    .bi-shell {
      width: min(calc(100% - 1.25rem), 620px);
    }

    .bi-kicker {
      margin-bottom: 0.75rem;
      font-size: 0.63rem;
      letter-spacing: 0.16em;
    }

    .bi-hero {
      padding-block: 2.4rem 1.5rem;
    }

    .bi-hero h1 {
      font-size: clamp(2.65rem, 13.5vw, 4rem);
      line-height: 0.98;
    }

    .bi-hero-lead {
      margin-top: 1rem;
      font-size: 0.97rem;
    }

    .bi-actions {
      margin-top: 1.3rem;
    }

    .bi-button {
      min-height: 45px;
      font-size: 0.82rem;
    }

    .bi-founder {
      min-height: 280px;
    }

    .bi-founder img {
      width: 118%;
      inset-inline-end: -16%;
    }

    .bi-founder-note {
      inset-inline-start: 1%;
      inset-inline-end: auto;
      inset-block-start: 6%;
      max-width: 125px;
      transform: rotate(-5deg);
    }

    .bi-founder-note span {
      font-size: 0.9rem;
    }

    .bi-product-wrap {
      padding-block: 3.3rem 3.8rem;
    }

    .bi-product h2 {
      font-size: clamp(2.7rem, 13vw, 3.7rem);
    }

    .bi-product-promise {
      margin-top: 0.9rem;
      font-size: 1.08rem;
    }

    .bi-product-body {
      font-size: 0.92rem;
    }

    .bi-product-gallery {
      display: grid;
      grid-template-columns: 1fr 0.86fr;
      gap: 0.75rem;
      align-items: end;
      min-height: 0;
      margin-top: 0.25rem;
    }

    .bi-screen {
      position: relative;
      inset: auto;
      width: auto;
      border-radius: 22px;
      transform: none;
    }

    .bi-screen-scan {
      z-index: 2;
    }

    .bi-screen-home {
      z-index: 1;
    }

    .bi-screen-insights {
      display: none;
    }

    .bi-screen figcaption {
      display: none;
    }

    .bi-benefits {
      margin-top: 1.4rem;
    }

    .bi-benefits article {
      grid-template-columns: 42px 1fr;
      padding: 1rem;
      border-radius: 20px;
    }

    .bi-benefit-icon {
      width: 42px;
      height: 42px;
      border-radius: 14px;
    }

    .bi-benefits p {
      font-size: 0.78rem;
    }

    .bi-philosophy {
      padding-block: 3.4rem 4rem;
    }

    .bi-philosophy h2 {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .bi-principles {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .bi-principles article {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 0 0.7rem;
      padding: 1rem 0;
      border-inline-start: 0;
      border-block-start: 1px solid #d9e6f0;
    }

    .bi-principles h3 {
      margin: 0;
    }

    .bi-principles p {
      grid-column: 2;
      margin-top: 0.35rem;
    }
  }

  @media (max-width: 420px) {
    .bi-hero h1 {
      font-size: clamp(2.5rem, 13.2vw, 3.25rem);
    }

    .bi-founder {
      min-height: 250px;
    }

    .bi-product-gallery {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bi-button,
    .bi-link {
      transition: none;
    }
  }
</style>
