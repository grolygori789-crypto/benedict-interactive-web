---
import SiteLayout from '../layouts/SiteLayout.astro';
import AccentHeading from './AccentHeading.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
const bear = copy.bear;

const heroA = locale === 'en' ? 'Bright software for' : home.headlineA;
const heroB = locale === 'en' ? 'calmer digital lives.' : home.headlineB;
const heroLead = locale === 'en'
  ? 'Thoughtful, human-centered software for a cleaner, simpler, brighter everyday.'
  : home.lead;
const founderNote = locale === 'en' ? 'Better tools. Brighter days!' : home.founderNote;

const distributionCopy: Record<LocaleCode, { uptodown: string; soon: string; safe: string; light: string; android: string }> = {
  en: { uptodown: 'Uptodown', soon: 'coming soon', safe: 'Safe & private', light: 'Lightweight', android: 'Made for Android' },
  th: { uptodown: 'Uptodown', soon: 'เร็วๆ นี้', safe: 'ปลอดภัยและเป็นส่วนตัว', light: 'เบาเครื่อง', android: 'สร้างมาสำหรับ Android' },
  es: { uptodown: 'Uptodown', soon: 'próximamente', safe: 'Seguro y privado', light: 'Ligero', android: 'Hecho para Android' },
  'pt-br': { uptodown: 'Uptodown', soon: 'em breve', safe: 'Seguro e privado', light: 'Leve', android: 'Feito para Android' },
  fr: { uptodown: 'Uptodown', soon: 'bientôt', safe: 'Sûr et privé', light: 'Léger', android: 'Conçu pour Android' },
  de: { uptodown: 'Uptodown', soon: 'demnächst', safe: 'Sicher & privat', light: 'Leichtgewichtig', android: 'Für Android gemacht' },
  it: { uptodown: 'Uptodown', soon: 'presto', safe: 'Sicuro e privato', light: 'Leggero', android: 'Creato per Android' },
  ja: { uptodown: 'Uptodown', soon: '近日公開', safe: '安全・プライベート', light: '軽快', android: 'Android向け' },
  ko: { uptodown: 'Uptodown', soon: '곧 공개', safe: '안전하고 비공개', light: '가볍게', android: 'Android용' },
  id: { uptodown: 'Uptodown', soon: 'segera', safe: 'Aman & privat', light: 'Ringan', android: 'Dibuat untuk Android' },
  vi: { uptodown: 'Uptodown', soon: 'sắp có', safe: 'An toàn & riêng tư', light: 'Gọn nhẹ', android: 'Dành cho Android' },
  'zh-cn': { uptodown: 'Uptodown', soon: '即将上线', safe: '安全且注重隐私', light: '轻巧流畅', android: '专为 Android 打造' },
  'zh-tw': { uptodown: 'Uptodown', soon: '即將上線', safe: '安全且重視隱私', light: '輕巧流暢', android: '專為 Android 打造' },
  ar: { uptodown: 'Uptodown', soon: 'قريبًا', safe: 'آمن وخاص', light: 'خفيف', android: 'مصمم لأندرويد' },
  hi: { uptodown: 'Uptodown', soon: 'जल्द आ रहा है', safe: 'सुरक्षित और निजी', light: 'हल्का', android: 'Android के लिए बनाया गया' },
  tr: { uptodown: 'Uptodown', soon: 'yakında', safe: 'Güvenli ve özel', light: 'Hafif', android: 'Android için' },
};
const dist = distributionCopy[locale];
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <div class="home-onepage">
    <section class="hero shell" id="home" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">{home.kicker}</p>
        <h1 id="home-title" class:list={{ 'hero-title-en': locale === 'en' }}>
          <span>{heroA}</span>
          <strong>{heroB}</strong>
        </h1>
        <p class="hero-lead">{heroLead}</p>
        <div class="actions">
          <a class="button primary" href="#bearagnostic">{home.primaryCta}<span aria-hidden="true">→</span></a>
          <a class="button secondary" href="#philosophy">{home.secondaryCta}</a>
        </div>
      </div>

      <figure class="founder-visual">
        <div class="founder-halo" aria-hidden="true"></div>
        <div class:list={['founder-signoff', { 'founder-signoff-en': locale === 'en' }]} role="img" aria-label={`${founderNote} Benedict J.`}>
          {locale === 'en' ? (
            <img
              class="founder-slogan"
              src="/brand/benedict-founder-slogan.svg"
              alt=""
              width="449"
              height="161"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span class="founder-note">{founderNote}</span>
          )}
          <img
            class="founder-signature"
            src="/brand/benedict-j-signature.svg"
            alt=""
            width="327"
            height="93"
            loading="eager"
            decoding="async"
          />
        </div>
        <img
          src="/brand/benedict-j-final.webp"
          alt="Benedict J. at a desk with a laptop and a sleeping dog"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="hero-proof" aria-label={home.kicker}>
        {home.proof.map((item, index) => (
          <span><i class={`dot dot-${index + 1}`} aria-hidden="true"></i>{item}</span>
        ))}
      </div>
    </section>

    <section class="product-band" id="bearagnostic" aria-labelledby="bearagnostic-title">
      <div class="product-shell shell">
        <div class="product-copy">
          <p class="eyebrow">{home.productKicker}</p>
          <h2 id="bearagnostic-title" class="product-wordmark" aria-label={home.productTitle}>
            <span class="wordmark-bear">Bear</span><span class="wordmark-agnostic">agnostic</span>
          </h2>
          <p class="promise">{home.productPromise}</p>
          <p class="product-body">{home.productBody}</p>

          <div class="download-actions" id="download">
            <a class="button primary download" href={localizedPath(locale, '/products/bearagnostic')}>
              {home.productCta}<span aria-hidden="true">→</span>
            </a>
            <span class="button secondary planned" title={`${dist.uptodown} · ${dist.soon}`} aria-label={`${dist.uptodown}, ${dist.soon}`}>
              {dist.uptodown}<small>{dist.soon}</small>
            </span>
          </div>

          <div class="micro-proof" aria-label={home.productTitle}>
            <span><i class="proof-dot proof-dot-safe" aria-hidden="true"></i>{dist.safe}</span>
            <span><i class="proof-dot proof-dot-light" aria-hidden="true"></i>{dist.light}</span>
            <span><i class="proof-dot proof-dot-android" aria-hidden="true"></i>{dist.android}</span>
          </div>
        </div>

        <div class="device-stage" aria-label={home.realScreen}>
          <figure class="device device-tools">
            <img src="/products/bearagnostic/final-tools.webp" alt="Bearagnostic tools screen" width="691" height="1536" loading="lazy" decoding="async" />
          </figure>
          <figure class="device device-scan">
            <img src="/products/bearagnostic/final-scan-safe.webp" alt="Bearagnostic scanning files locally on the device" width="691" height="1536" loading="eager" decoding="async" />
            <figcaption>{home.realScreen}</figcaption>
          </figure>
          <figure class="device device-depth">
            <img src="/products/bearagnostic/final-depth.webp" alt="Bearagnostic scan depth choices" width="691" height="1536" loading="lazy" decoding="async" />
          </figure>
        </div>

        <div class="feature-stack" aria-label={bear.featuresTitle}>
          {bear.features.slice(0, 3).map((item, index) => (
            <article class={`feature feature-${index + 1}`}>
              <span class="feature-icon" aria-hidden="true">{index === 0 ? '▣' : index === 1 ? '▥' : '◆'}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy shell" id="philosophy" aria-labelledby="philosophy-title">
      <div class="philosophy-head">
        <p class="eyebrow">{home.philosophyKicker}</p>
        <AccentHeading as="h2" id="philosophy-title" class="philosophy-title" text={home.philosophyTitle} />
      </div>
      <div class="principles">
        {home.principles.map((item, index) => (
          <article>
            <span class={`principle-icon principle-${index + 1}`} aria-hidden="true">{index === 0 ? '●' : index === 1 ? '◇' : '♥'}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .home-onepage {
    overflow: clip;
    color: #10213a;
    background:
      radial-gradient(circle at 82% 6%, rgba(84, 201, 236, 0.15), transparent 31rem),
      radial-gradient(circle at 8% 24%, rgba(33, 131, 244, 0.06), transparent 28rem),
      #f8fbff;
  }

  .shell {
    width: min(calc(100% - 3rem), 1240px);
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: #3a83c2;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 820;
    letter-spacing: var(--type-label-tracking);
    line-height: var(--type-label-leading);
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    grid-template-areas:
      "copy founder"
      "proof proof";
    gap: 0 clamp(1.8rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2.7rem, 5vw, 4.8rem) 1rem;
  }

  .hero::before {
    position: absolute;
    z-index: 0;
    inset: 4% -11% 13% 46%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(81, 195, 232, 0.2), rgba(81, 195, 232, 0));
    filter: blur(30px);
    content: "";
    pointer-events: none;
  }

  .hero-copy {
    grid-area: copy;
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 660px;
    min-width: 0;
    overflow: visible;
    padding-block: 1rem 2rem;
  }

  .hero h1,
  .product-copy h2,
  :global(.philosophy-title) {
    margin: 0;
    color: #101f36;
    font-family: var(--font-display);
    font-weight: var(--type-heading-weight);
    text-wrap: balance;
  }

  .hero h1 {
    font-size: clamp(var(--home-hero-min), var(--home-hero-fluid), var(--home-hero-max));
    line-height: var(--home-hero-leading);
    letter-spacing: var(--home-hero-tracking);
    overflow: visible;
  }

  .hero h1 span,
  .hero h1 strong {
    display: block;
    overflow: visible;
    padding: 0 0 0.12em;
    line-height: inherit;
  }

  .hero h1 strong { color: #1688f3; }

  .hero-title-en span,
  .hero-title-en strong { white-space: nowrap; }

  .hero-lead {
    max-width: 560px;
    margin: 1.15rem 0 0;
    color: #62758b;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: var(--home-lead-leading);
  }

  .actions,
  .download-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.72rem;
    align-items: center;
    margin-top: 1.55rem;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-inline: 1.2rem;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 760;
    line-height: var(--type-ui-leading);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .button:hover { transform: translateY(-2px); }

  .button.primary {
    color: #fff;
    background: linear-gradient(135deg, #087ff0, #20a7f4);
    box-shadow: 0 14px 34px rgba(17, 129, 235, 0.23);
  }

  .button.secondary {
    color: #1d66a7;
    border: 1px solid #c7ddec;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 10px 28px rgba(42, 79, 116, 0.04);
  }

  .founder-visual {
    grid-area: founder;
    position: relative;
    z-index: 1;
    min-height: clamp(420px, 36vw, 535px);
    margin: 0;
    isolation: isolate;
  }

  .founder-halo {
    position: absolute;
    z-index: -1;
    inset: 8% 1% 2% 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(80, 194, 231, 0.22), rgba(80, 194, 231, 0));
    filter: blur(25px);
  }

  .founder-visual > img {
    position: absolute;
    right: -2%;
    bottom: 0;
    width: 112%;
    max-width: none;
    height: auto;
    filter: drop-shadow(0 28px 38px rgba(40, 83, 118, 0.1));
  }

  .founder-signoff {
    position: absolute;
    z-index: 2;
    left: 7.5%;
    top: 12.5%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.42rem;
    width: min(42%, 330px);
    color: #208ce9;
    text-align: left;
    transform: rotate(-3deg);
    transform-origin: 20% 50%;
    pointer-events: none;
  }

  .founder-slogan {
    display: block;
    width: 100%;
    height: auto;
  }

  .founder-note {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.75vw, 1.45rem);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }

  .founder-signature {
    position: static;
    display: block;
    width: clamp(142px, 58%, 194px);
    max-width: 62%;
    height: auto;
    margin-left: 1.05rem;
    filter: none;
    opacity: 0.98;
  }

  .hero-proof {
    grid-area: proof;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.8rem;
    align-items: center;
    min-height: 48px;
    padding-block: 0.95rem 0.15rem;
    border-block-start: 1px solid rgba(31, 74, 113, 0.13);
    color: #65788d;
    font-size: 0.73rem;
    font-weight: 720;
  }

  .hero-proof span { display: inline-flex; align-items: center; gap: 0.48rem; }
  .dot { width: 7px; height: 7px; border-radius: 50%; }
  .dot-1 { background: #1c80ef; }
  .dot-2 { background: #41bad5; }
  .dot-3 { background: #dda04b; }

  .product-band {
    padding-block: clamp(2.9rem, 5vw, 4.6rem);
    border-block: 1px solid rgba(24, 53, 83, 0.07);
    background:
      radial-gradient(circle at 60% 30%, rgba(73, 190, 231, 0.12), transparent 34rem),
      linear-gradient(180deg, rgba(255,255,255,0.86), rgba(242,248,253,0.97));
  }

  .product-shell {
    display: grid;
    grid-template-columns: minmax(270px, 0.78fr) minmax(520px, 1.35fr) minmax(250px, 0.74fr);
    gap: clamp(1.6rem, 3vw, 2.7rem);
    align-items: center;
  }

  .product-copy { max-width: 420px; }

  .product-copy h2 {
    font-size: clamp(2.8rem, 4.5vw, 4.5rem);
    line-height: var(--home-product-leading);
    letter-spacing: var(--type-heading-tracking);
  }

  .product-wordmark {
    white-space: nowrap;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-weight: 790;
    letter-spacing: -0.052em;
    line-height: 0.98;
  }

  .wordmark-bear { color: #10213a; }
  .wordmark-agnostic { color: #168cf3; }

  .promise {
    margin: 1rem 0 0;
    color: #214d77;
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    font-weight: 770;
    line-height: var(--type-body-leading);
  }

  .product-body {
    margin: 0.85rem 0 0;
    color: #687b90;
    font-size: 0.92rem;
    line-height: var(--type-body-leading);
  }

  .download-actions { gap: 0.55rem; margin-top: 1.3rem; }
  .download { padding-inline: 1rem; }
  .planned { gap: 0.35rem; cursor: default; }
  .planned small { color: #7d8da0; font-size: 0.62rem; font-weight: 700; }

  .micro-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1.1rem;
    color: #6081a0;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .micro-proof span {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .proof-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(20, 132, 242, 0.06);
  }

  .proof-dot-safe { background: #20a97d; }
  .proof-dot-light { background: #6a75e8; }
  .proof-dot-android { background: #178af3; }

  .device-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.06fr) minmax(0, 0.8fr);
    gap: clamp(0.45rem, 1vw, 0.8rem);
    align-items: end;
    min-width: 0;
    perspective: 1400px;
  }

  .device {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(24, 52, 82, 0.11);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 28px 62px rgba(35, 72, 110, 0.13);
    transform-origin: 50% 88%;
    transition: transform 260ms cubic-bezier(.2,.7,.2,1), box-shadow 260ms ease;
  }

  .device:hover {
    z-index: 5;
    box-shadow: 0 38px 80px rgba(31, 71, 112, 0.2);
  }

  .device img { display: block; width: 100%; height: auto; }
  .device-tools { transform: translateY(20px) rotateY(5deg) rotateZ(-1deg); }
  .device-depth { transform: translateY(18px) rotateY(-5deg) rotateZ(1deg); }
  .device-scan {
    z-index: 3;
    transform: translateY(-8px);
    box-shadow: 0 34px 76px rgba(31, 71, 112, 0.18);
    animation: scanFloat 6s ease-in-out infinite;
  }
  .device-tools:hover { transform: translateY(8px) rotateY(2deg) rotateZ(-0.4deg) scale(1.015); }
  .device-depth:hover { transform: translateY(7px) rotateY(-2deg) rotateZ(0.4deg) scale(1.015); }
  .device-scan:hover { transform: translateY(-14px) scale(1.015); animation-play-state: paused; }

  .device figcaption {
    position: absolute;
    inset-inline-start: 0.65rem;
    inset-block-end: 0.65rem;
    padding: 0.36rem 0.58rem;
    color: #20537f;
    border: 1px solid rgba(255,255,255,0.92);
    border-radius: 999px;
    background: rgba(255,255,255,0.88);
    box-shadow: 0 8px 24px rgba(27, 70, 105, 0.09);
    backdrop-filter: blur(10px);
    font-size: 0.6rem;
    font-weight: 780;
  }

  @keyframes scanFloat {
    0%, 100% { transform: translateY(-8px); }
    50% { transform: translateY(-14px); }
  }

  .feature-stack { display: grid; gap: 0.75rem; }

  .feature {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 0.82rem;
    align-items: start;
    padding: 1rem;
    border: 1px solid rgba(27, 60, 94, 0.08);
    border-radius: 20px;
    background: rgba(255,255,255,0.84);
    box-shadow: 0 15px 34px rgba(35, 76, 112, 0.05);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .feature:hover { transform: translateY(-2px); box-shadow: 0 20px 42px rgba(35, 76, 112, 0.09); }

  .feature-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 850;
  }

  .feature-1 .feature-icon { color: #0a82eb; background: #e3f3ff; }
  .feature-2 .feature-icon { color: #7b5de7; background: #f0ecff; }
  .feature-3 .feature-icon { color: #13a97a; background: #e3fbf3; }
  .feature h3 { margin: 0; color: #14243a; font-size: 0.92rem; letter-spacing: var(--type-heading-tracking); line-height: var(--type-heading-leading); }
  .feature p { margin: 0.28rem 0 0; color: #718197; font-size: 0.74rem; line-height: var(--home-card-leading); }

  .philosophy {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 2.2fr);
    gap: clamp(1.5rem, 3.2vw, 3rem);
    align-items: center;
    margin-block: clamp(2.8rem, 4vw, 4rem);
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border: 1px solid rgba(27, 60, 94, 0.08);
    border-radius: 28px;
    background: rgba(255,255,255,0.72);
    box-shadow: 0 18px 46px rgba(42, 76, 111, 0.05);
  }

  :global(.philosophy-title) { max-width: 410px; font-size: clamp(1.9rem, 2.65vw, 2.7rem); line-height: var(--home-philosophy-leading); letter-spacing: var(--home-philosophy-tracking); }

  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem; }
  .principles article {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 0.72rem;
    align-items: start;
    min-width: 0;
    padding: 0.95rem;
    border-inline-start: 1px solid rgba(28, 63, 99, 0.09);
  }
  .principle-icon { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 13px; }
  .principle-1 { color: #0c7fe5; background: #e4f4ff; }
  .principle-2 { color: #0f83d9; background: #e7f6ff; }
  .principle-3 { color: #1684ef; background: #e8f4ff; }
  .principles h3 { margin: 0; font-size: 0.84rem; letter-spacing: var(--type-heading-tracking); line-height: var(--type-heading-leading); }
  .principles p { margin: 0.25rem 0 0; color: #74849a; font-size: 0.72rem; line-height: var(--home-card-leading); }

  @media (max-width: 1110px) {
    .hero h1 { font-size: clamp(var(--home-hero-min), var(--home-hero-fluid), var(--home-hero-max)); }
    .product-shell { grid-template-columns: minmax(240px, 0.72fr) minmax(455px, 1.28fr); }
    .feature-stack { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr); }
    .feature { min-height: 112px; }
  }

  @media (max-width: 900px) {
    .shell { width: min(calc(100% - 2rem), 860px); }
