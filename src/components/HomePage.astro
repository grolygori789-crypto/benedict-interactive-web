---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
const bear = copy.bear;
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <section class="home-hero shell" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="section-label">{home.kicker}</p>
      <h1 id="home-title">
        <span>{home.headlineA}</span>
        <strong>{home.headlineB}</strong>
      </h1>
      <p class="hero-lead">{home.lead}</p>

      <div class="hero-actions">
        <a class="button button-primary" href="#bearagnostic">
          {home.primaryCta}<span aria-hidden="true">→</span>
        </a>
        <a class="button button-quiet" href="#philosophy">{home.secondaryCta}</a>
      </div>

      <div class="trust-line" aria-label={home.kicker}>
        {home.proof.map((item, index) => (
          <span><i class={`trust-dot trust-dot-${index + 1}`} aria-hidden="true"></i>{item}</span>
        ))}
      </div>
    </div>

    <figure class="founder-visual">
      <img
        src="/brand/benedict-j.webp"
        alt="Benedict J. at his desk with a laptop and a sleeping dog"
        width="1672"
        height="941"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <strong>Benedict J.</strong>
        <span>{home.founderRole}</span>
      </figcaption>
    </figure>
  </section>

  <section class="home-product" id="bearagnostic" aria-labelledby="bearagnostic-title">
    <div class="shell product-grid">
      <div class="product-copy">
        <p class="section-label">{home.productKicker}</p>
        <h2 id="bearagnostic-title">{home.productTitle}</h2>
        <p class="product-promise">{home.productPromise}</p>
        <p class="product-body">{home.productBody}</p>

        <div class="product-points" aria-label="Bearagnostic qualities">
          {home.productTags.map((tag, index) => (
            <div class="product-point">
              <span>0{index + 1}</span>
              <strong>{tag}</strong>
            </div>
          ))}
        </div>

        <div class="product-actions">
          <a class="button button-primary" href={localizedPath(locale, '/products/bearagnostic')}>
            {home.productCta}<span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={localizedPath(locale, '/support')}>
            {home.productSupport}<span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="device-stage" aria-label={home.productTitle}>
        <div class="device-halo" aria-hidden="true"></div>
        <figure class="device device-secondary">
          <img
            src="/products/bearagnostic/app-insights.webp"
            alt="Bearagnostic insights screen"
            width="691"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="device device-main">
          <img
            src="/products/bearagnostic/app-home.webp"
            alt="Bearagnostic home screen"
            width="691"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <span class="real-screen-label">{home.realScreen}</span>
      </div>
    </div>
  </section>

  <section class="workflow-section shell" aria-labelledby="workflow-title">
    <div class="workflow-heading">
      <div>
        <p class="section-label">{bear.featuresKicker}</p>
        <h2 id="workflow-title">{bear.featuresTitle}</h2>
      </div>
      <p>{bear.lead}</p>
    </div>

    <div class="workflow-grid">
      <figure class="scan-visual">
        <img
          src="/products/bearagnostic/app-scan-safe.webp"
          alt="Bearagnostic scanning files on device"
          width="691"
          height="1536"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="workflow-copy">
        {bear.features.map((item, index) => (
          <article class="workflow-fact">
            <span>0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="philosophy-section" id="philosophy" aria-labelledby="philosophy-title">
    <div class="shell philosophy-grid">
      <div class="philosophy-copy">
        <p class="section-label">{home.philosophyKicker}</p>
        <h2 id="philosophy-title">{home.philosophyTitle}</h2>
        <p>{home.philosophyBody}</p>
      </div>

      <div class="principle-list">
        {home.principles.map((item, index) => (
          <article class="principle-row">
            <span>0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-closing shell" aria-labelledby="closing-title">
    <div>
      <p class="section-label">{home.closingKicker}</p>
      <h2 id="closing-title">{home.closingTitle}</h2>
      <p>{home.closingBody}</p>
    </div>
    <a class="button button-light" href={localizedPath(locale, '/products')}>
      {home.closingCta}<span aria-hidden="true">→</span>
    </a>
  </section>
</SiteLayout>
