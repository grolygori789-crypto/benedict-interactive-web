---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
const bear = copy.bear;

const heroA = locale === 'en' ? 'Bright software for' : home.headlineA;
const heroB = locale === 'en' ? 'calmer digital lives.' : home.headlineB;
const heroLead = locale === 'en'
  ? 'Thoughtful software for a cleaner, simpler, brighter everyday.'
  : home.lead;
const heroNote = locale === 'en' ? 'Better tools. Brighter days.' : home.founderNote;
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <div class="bi-home">
    <section class:list={["bi-hero", "bi-shell", { "bi-hero-en": locale === 'en' }]} aria-labelledby="home-title">
      <div class="bi-hero-copy">
        <p class="bi-kicker">{home.kicker}</p>
        <h1 id="home-title">
          <span>{heroA}</span>
          <strong>{heroB}</strong>
        </h1>
        <p class="bi-hero-lead">{heroLead}</p>

        <div class="bi-actions">
          <a class="bi-button bi-button-primary" href="#bearagnostic">
            {home.primaryCta}<span aria-hidden="true">→</span>
          </a>
          <a class="bi-button bi-button-secondary" href="#philosophy">
            {home.secondaryCta}
          </a>
        </div>

        <div class="bi-hero-signoff" aria-label="Benedict J.">
          <span>{heroNote}</span>
          <strong>Benedict J.</strong>
        </div>
      </div>

      <figure class="bi-founder">
        <div class="bi-founder-glow" aria-hidden="true"></div>
        <img
          src="/brand/benedict-j.webp"
          alt="Benedict J. at his desk with a laptop and a sleeping dog"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="bi-hero-proof" aria-label={home.kicker}>
        {home.proof.map((item, index) => (
          <span>
            <i class:list={["bi-proof-dot", `bi-proof-dot-${index + 1}`]} aria-hidden="true"></i>
            {item}
          </span>
        ))}
      </div>
    </section>

    <section class="bi-product-wrap" id="bearagnostic" aria-labelledby="bearagnostic-title">
      <div class="bi-product bi-shell">
        <div class="bi-product-copy">
          <p class="bi-kicker">{home.productKicker}</p>
          <h2 id="bearagnostic-title">{home.productTitle}</h2>
          <p class="bi-product-promise">{home.productPromise}</p>
          <p class="bi-product-body">{home.productBody}</p>

          <div class="bi-actions bi-product-actions">
            <a class="bi-button bi-button-primary" href={localizedPath(locale, '/products/bearagnostic')}>
              {home.productCta}<span aria-hidden="true">→</span>
            </a>
            <a class="bi-link" href={localizedPath(locale, '/support')}>
              {home.productSupport}<span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="bi-product-gallery" aria-label={home.productTitle}>
          <figure class="bi-screen bi-screen-insights">
            <img
              src="/products/bearagnostic/app-insights.webp"
              alt="Bearagnostic insights screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <figure class="bi-screen bi-screen-scan">
            <img
              src="/products/bearagnostic/app-scan-safe.webp"
              alt="Bearagnostic scanning files locally on device"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{home.realScreen}</figcaption>
          </figure>

          <figure class="bi-screen bi-screen-home">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>

      <div class="bi-benefits bi-shell" aria-label={home.productTitle}>
        {bear.features.map((item, index) => (
          <article>
            <span class:list={["bi-benefit-icon", `bi-benefit-icon-${index + 1}`]} aria-hidden="true">
              {index === 0 ? '✦' : index === 1 ? '◇' : '⌁'}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bi-philosophy bi-shell" id="philosophy" aria-labelledby="philosophy-title">
      <div class="bi-philosophy-title">
        <p class="bi-kicker">{home.philosophyKicker}</p>
        <h2 id="philosophy-title">{home.philosophyTitle}</h2>
        <p class="bi-philosophy-body">{home.philosophyBody}</p>
      </div>

      <div class="bi-philosophy-side">
        <div class="bi-principles">
          {home.principles.map((item, index) => (
            <article>
              <span aria-hidden="true">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>

        <blockquote class="bi-studio-quote">
          <p>“{home.studioQuote}”</p>
          <footer>— Benedict J.</footer>
        </blockquote>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .bi-home {
    overflow: clip;
    color: #10213a;
    background:
      radial-gradient(circle at 82% 7%, rgba(76, 196, 234, 0.13), transparent 25rem),
      radial-gradient(circle at 12% 20%, rgba(45, 126, 246, 0.06), transparent 28rem),
      #f8fbff;
  }

  .bi-shell {
    width: min(calc(100% - 3rem), 1240px);
    margin-inline: auto;
  }

  .bi-kicker {
    margin: 0 0 0.85rem;
    color: #3d7eb8;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .bi-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    grid-template-areas:
      "copy founder"
      "proof proof";
    gap: 1.4rem clamp(2.2rem, 4.2vw, 4.4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 4.8vw, 4.5rem) 1.7rem;
  }

  .bi-hero-copy {
    grid-area: copy;
    position: relative;
    z-index: 2;
    max-width: 610px;
    padding-block: 0.7rem;
  }

  .bi-hero h1,
  .bi-product h2,
  .bi-philosophy h2 {
    margin: 0;
    letter-spacing: -0.048em;
    text-wrap: balance;
  }

  .bi-hero h1 {
    overflow: visible;
    font-size: clamp(3.35rem, 5.05vw, 4.55rem);
    line-height: 1.015;
  }

  .bi-hero h1 span,
  .bi-hero h1 strong {
    display: block;
    overflow: visible;
    padding-block-end: 0.055em;
  }

  @media (min-width: 941px) {
    .bi-hero-en h1 span,
    .bi-hero-en h1 strong {
      white-space: nowrap;
    }
  }

  .bi-hero h1 strong {
    color: #1c7ff2;
    font-weight: inherit;
    background: linear-gradient(105deg, #185ecf 0%, #1e87f7 55%, #48c6de 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bi-hero-lead {
    max-width: 515px;
    margin: 1.15rem 0 0;
    color: #63758c;
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    line-height: 1.62;
  }

  .bi-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.72rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .bi-button,
  .bi-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 46px;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 760;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .bi-button {
    padding-inline: 1.15rem;
  }

  .bi-button:hover,
  .bi-link:hover {
    transform: translateY(-1px);
  }

  .bi-button-primary {
    color: #fff;
    background: linear-gradient(135deg, #087ff0, #22a8f5);
    box-shadow: 0 14px 32px rgba(17, 129, 235, 0.22);
  }

  .bi-button-secondary {
    color: #1d5f9f;
    border: 1px solid #c8dded;
    background: rgba(255, 255, 255, 0.82);
  }

  .bi-link {
    min-height: 42px;
    padding-inline: 0.3rem;
    color: #2d6fae;
  }

  .bi-hero-signoff {
    display: grid;
    width: fit-content;
    gap: 0.15rem;
    margin-top: 1.5rem;
    color: #2c85e8;
    transform: rotate(-2.5deg);
  }

  .bi-hero-signoff span {
    max-width: 250px;
    font-family: "Segoe Print", "Bradley Hand", cursive;
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.2;
  }

  .bi-hero-signoff strong {
    justify-self: end;
    color: #385a7d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.75rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .bi-founder {
    grid-area: founder;
    position: relative;
    min-height: clamp(390px, 34vw, 510px);
    margin: 0;
    isolation: isolate;
  }

  .bi-founder-glow {
    position: absolute;
    z-index: -1;
    inset: 7% 2% 4% 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(83, 195, 226, 0.24), rgba(83, 195, 226, 0));
    filter: blur(24px);
  }

  .bi-founder img {
    position: absolute;
    inset-inline-end: -1.5%;
    inset-block-end: 0;
    width: 107%;
    max-width: none;
    height: auto;
  }

  .bi-hero-proof {
    grid-area: proof;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.7rem;
    align-items: center;
    min-height: 48px;
    padding-block: 0.9rem 0.25rem;
    border-block-start: 1px solid rgba(55, 96, 137, 0.13);
    color: #687b90;
    font-size: 0.75rem;
    font-weight: 720;
  }

  .bi-hero-proof span {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
  }

  .bi-proof-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .bi-proof-dot-1 { background: #1c80ef; }
  .bi-proof-dot-2 { background: #43bed8; }
  .bi-proof-dot-3 { background: #e1a149; }

  .bi-product-wrap {
    padding-block: clamp(3.8rem, 6vw, 5.7rem);
    border-block: 1px solid rgba(28, 54, 84, 0.07);
    background:
      radial-gradient(circle at 70% 30%, rgba(59, 190, 228, 0.12), transparent 34rem),
      linear-gradient(180deg, rgba(255,255,255,0.82), rgba(244,249,253,0.96));
  }

  .bi-product {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(560px, 1.28fr);
    gap: clamp(2.3rem, 4.8vw, 4.7rem);
    align-items: center;
  }

  .bi-product-copy {
    max-width: 490px;
  }

  .bi-product h2 {
    font-size: clamp(2.9rem, 4.9vw, 4.9rem);
    line-height: 1;
  }

  .bi-product-promise {
    margin: 1.05rem 0 0;
    color: #234d78;
    font-size: clamp(1.1rem, 1.55vw, 1.34rem);
    font-weight: 760;
    line-height: 1.38;
  }

  .bi-product-body {
    margin: 0.9rem 0 0;
    color: #65788e;
    line-height: 1.68;
  }

  .bi-product-gallery {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.08fr) minmax(0, 0.9fr);
    gap: clamp(0.7rem, 1.25vw, 1rem);
    align-items: end;
    min-width: 0;
  }

  .bi-screen {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(18, 40, 65, 0.08);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 58px rgba(29, 63, 102, 0.12);
  }

  .bi-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .bi-screen-insights {
    transform: translateY(18px) rotate(-0.8deg);
  }

  .bi-screen-scan {
    z-index: 2;
    transform: translateY(-10px);
    box-shadow: 0 28px 70px rgba(29, 63, 102, 0.16);
  }

  .bi-screen-home {
    transform: translateY(12px) rotate(0.8deg);
  }

  .bi-screen figcaption {
    position: absolute;
    inset-inline-start: 0.7rem;
    inset-block-end: 0.7rem;
    padding: 0.4rem 0.62rem;
    color: #214e79;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    font-size: 0.62rem;
    font-weight: 780;
  }

  .bi-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-top: clamp(2rem, 3vw, 2.8rem);
  }

  .bi-benefits article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    min-width: 0;
    padding: 1.05rem 1.15rem;
    border: 1px solid rgba(26, 58, 91, 0.08);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 14px 34px rgba(39, 78, 118, 0.05);
  }

  .bi-benefit-icon {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border-radius: 14px;
    font-size: 1.08rem;
    font-weight: 800;
  }

  .bi-benefit-icon-1 { color: #087de6; background: #e5f4ff; }
  .bi-benefit-icon-2 { color: #7b5de9; background: #f0ecff; }
  .bi-benefit-icon-3 { color: #17a879; background: #e5fbf4; }

  .bi-benefits h3 {
    margin: 0;
    font-size: 0.96rem;
    letter-spacing: -0.015em;
  }

  .bi-benefits p {
    margin: 0.3rem 0 0;
    color: #718196;
    font-size: 0.78rem;
    line-height: 1.48;
  }

  .bi-philosophy {
    display: grid;
    grid-template-columns: minmax(330px, 0.83fr) minmax(0, 1.17fr);
    gap: clamp(2.2rem, 4vw, 4.2rem);
    align-items: stretch;
    margin-block: clamp(3.3rem, 5.6vw, 5rem);
    padding: clamp(2rem, 3.5vw, 3.2rem);
    border: 1px solid rgba(29, 62, 96, 0.08);
    border-radius: 30px;
    background:
      radial-gradient(circle at 90% 12%, rgba(71, 190, 224, 0.1), transparent 22rem),
      rgba(255, 255, 255, 0.7);
    box-shadow: 0 18px 48px rgba(41, 75, 108, 0.05);
  }

  .bi-philosophy-title {
    align-self: start;
  }

  .bi-philosophy h2 {
    max-width: 455px;
    font-size: clamp(2.35rem, 3.4vw, 3.35rem);
    line-height: 1.04;
  }

  .bi-philosophy-body {
    max-width: 455px;
    margin: 1.15rem 0 0;
    color: #6d7e91;
    font-size: 0.9rem;
    line-height: 1.66;
  }

  .bi-philosophy-side {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.15rem;
    min-width: 0;
  }

  .bi-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .bi-principles article {
    min-width: 0;
    padding: 1.05rem;
    border: 1px solid rgba(29, 62, 96, 0.08);
    border-radius: 20px;
    background: rgba(248, 252, 255, 0.78);
  }

  .bi-principles span {
    color: #2980d8;
    font-size: 0.68rem;
    font-weight: 820;
    letter-spacing: 0.12em;
  }

  .bi-principles h3 {
    margin: 0.75rem 0 0;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
  }

  .bi-principles p {
    margin: 0.4rem 0 0;
    color: #718196;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .bi-studio-quote {
    display: grid;
    align-content: center;
    min-height: 150px;
    margin: 0;
    padding: 1.35rem 1.5rem;
    overflow: hidden;
    border-radius: 22px;
    background:
      radial-gradient(circle at 92% 10%, rgba(66, 188, 221, 0.2), transparent 16rem),
      linear-gradient(135deg, #153454, #1f557d);
    color: #fff;
  }

  .bi-studio-quote p {
    max-width: 620px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-style: italic;
    line-height: 1.38;
  }

  .bi-studio-quote footer {
    margin-top: 0.7rem;
    color: rgba(222, 239, 250, 0.82);
    font-size: 0.76rem;
    font-weight: 680;
  }

  @media (max-width: 1120px) {
    .bi-hero {
      grid-template-columns: minmax(0, 0.94fr) minmax(430px, 1.06fr);
      gap: 1.2rem 2.2rem;
    }

    .bi-hero h1 {
      font-size: clamp(3.1rem, 5vw, 3.9rem);
    }

    .bi-product {
      grid-template-columns: minmax(0, 0.76fr) minmax(500px, 1.24fr);
      gap: 2.2rem;
    }
  }

  @media (max-width: 940px) {
    .bi-shell {
      width: min(calc(100% - 2rem), 900px);
    }

    .bi-hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "founder"
        "proof";
      gap: 1rem;
      padding-block: 3rem 1.5rem;
    }

    .bi-hero-copy {
      max-width: 720px;
      padding-block: 0;
    }

    .bi-hero h1 {
      max-width: 760px;
      font-size: clamp(3.3rem, 8vw, 5rem);
    }

    .bi-founder {
      min-height: 430px;
    }

    .bi-founder img {
      width: 101%;
      inset-inline-end: -1%;
    }

    .bi-hero-signoff {
      margin-top: 1.2rem;
    }

    .bi-product {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .bi-product-copy {
      max-width: 700px;
    }

    .bi-product-gallery {
      width: min(100%, 760px);
      margin-inline: auto;
    }

    .bi-benefits {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .bi-philosophy {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .bi-shell {
      width: min(calc(100% - 1.25rem), 620px);
    }

    .bi-kicker {
      margin-bottom: 0.7rem;
      font-size: 0.61rem;
      letter-spacing: 0.15em;
    }

    .bi-hero {
      padding-block: 2.2rem 1rem;
    }

    .bi-hero h1 {
      font-size: clamp(2.65rem, 13.2vw, 3.75rem);
      line-height: 1.01;
    }

    .bi-hero h1 span,
    .bi-hero h1 strong {
      padding-block-end: 0.03em;
    }

    .bi-hero-lead {
      margin-top: 0.9rem;
      font-size: 0.96rem;
    }

    .bi-actions {
      margin-top: 1.15rem;
    }

    .bi-button {
      min-height: 44px;
      font-size: 0.81rem;
    }

    .bi-hero-signoff {
      margin-top: 1.15rem;
    }

    .bi-hero-signoff span {
      font-size: 0.92rem;
    }

    .bi-founder {
      min-height: 275px;
    }

    .bi-founder img {
      width: 113%;
      inset-inline-end: -12%;
    }

    .bi-hero-proof {
      gap: 0.55rem 1rem;
      min-height: 0;
      padding-top: 0.8rem;
      font-size: 0.68rem;
    }

    .bi-product-wrap {
      padding-block: 3rem 3.4rem;
    }

    .bi-product h2 {
      font-size: clamp(2.65rem, 12.7vw, 3.6rem);
    }

    .bi-product-promise {
      margin-top: 0.85rem;
      font-size: 1.06rem;
    }

    .bi-product-body {
      font-size: 0.9rem;
    }

    .bi-product-gallery {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 0.55rem;
      align-items: end;
      margin-top: 0.2rem;
    }

    .bi-screen {
      border-radius: 21px;
      transform: none;
    }

    .bi-screen-insights {
      display: none;
    }

    .bi-screen-scan {
      order: 1;
    }

    .bi-screen-home {
      order: 2;
      transform: translateY(10px);
    }

    .bi-screen figcaption {
      display: none;
    }

    .bi-benefits {
      margin-top: 1.45rem;
    }

    .bi-benefits article {
      grid-template-columns: 40px 1fr;
      padding: 0.95rem;
      border-radius: 19px;
    }

    .bi-benefit-icon {
      width: 40px;
      height: 40px;
      border-radius: 13px;
    }

    .bi-benefits p {
      font-size: 0.76rem;
    }

    .bi-philosophy {
      margin-block: 2.8rem 3.5rem;
      padding: 1.35rem;
      border-radius: 24px;
    }

    .bi-philosophy h2 {
      font-size: clamp(2rem, 9.4vw, 2.85rem);
    }

    .bi-philosophy-body {
      margin-top: 0.9rem;
      font-size: 0.84rem;
    }

    .bi-principles {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .bi-principles article {
      padding: 0.95rem;
      border-radius: 17px;
    }

    .bi-principles h3 {
      margin-top: 0.5rem;
    }

