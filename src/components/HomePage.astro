---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLocaleContent, localizedPath, type LocaleCode } from '../i18n/content';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const copy = getLocaleContent(locale);
const home = copy.home;
const bear = copy.bear;
---

<SiteLayout title="Benedict Interactive" description={home.metaDescription} locale={locale}>
  <div class="home-page">
    <section class="home-hero shell" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="section-label">{home.kicker}</p>
        <h1 id="home-title">
          <span>{home.headlineA}</span>
          <strong>{home.headlineB}</strong>
        </h1>
        <p class="hero-lead">{home.lead}</p>

        <div class="hero-actions">
          <a class="button button-primary" href="#bearagnostic">
            {home.primaryCta}<span aria-hidden="true">→</span>
          </a>
          <a class="button button-quiet" href="#philosophy">{home.secondaryCta}</a>
        </div>

        <div class="trust-line" aria-label={home.kicker}>
          {home.proof.map((item, index) => (
            <span><i class={`trust-dot trust-dot-${index + 1}`} aria-hidden="true"></i>{item}</span>
          ))}
        </div>
      </div>

      <figure class="founder-visual">
        <div class="founder-glow" aria-hidden="true"></div>
        <img
          src="/brand/benedict-j.webp"
          alt="Benedict J. at his desk with a laptop and a sleeping dog"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          <strong>Benedict J.</strong>
          <span>{home.founderRole}</span>
        </figcaption>
      </figure>
    </section>

    <section class="home-product" id="bearagnostic" aria-labelledby="bearagnostic-title">
      <div class="shell product-grid">
        <div class="product-copy">
          <p class="section-label">{home.productKicker}</p>
          <h2 id="bearagnostic-title">{home.productTitle}</h2>
          <p class="product-promise">{home.productPromise}</p>
          <p class="product-body">{home.productBody}</p>

          <div class="quality-line" aria-label="Bearagnostic qualities">
            {home.productTags.map((tag) => <span>{tag}</span>)}
          </div>

          <div class="product-actions">
            <a class="button button-primary" href={localizedPath(locale, '/products/bearagnostic')}>
              {home.productCta}<span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href={localizedPath(locale, '/support')}>
              {home.productSupport}<span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="device-stage" aria-label={home.productTitle}>
          <div class="stage-glow" aria-hidden="true"></div>
          <figure class="device device-secondary">
            <img
              src="/products/bearagnostic/app-insights.webp"
              alt="Bearagnostic insights screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure class="device device-main">
            <img
              src="/products/bearagnostic/app-home.webp"
              alt="Bearagnostic home screen"
              width="691"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <span class="real-screen-label">{home.realScreen}</span>
        </div>
      </div>
    </section>

    <section class="workflow-section shell" aria-labelledby="workflow-title">
      <div class="workflow-heading">
        <div>
          <p class="section-label">{bear.featuresKicker}</p>
          <h2 id="workflow-title">{bear.featuresTitle}</h2>
        </div>
        <p>{bear.lead}</p>
      </div>

      <div class="workflow-grid">
        <figure class="scan-visual">
          <img
            src="/products/bearagnostic/app-scan-safe.webp"
            alt="Bearagnostic scanning files locally on device"
            width="691"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="workflow-copy">
          {bear.features.map((item, index) => (
            <article class="workflow-fact">
              <span>0{index + 1}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy-section shell" id="philosophy" aria-labelledby="philosophy-title">
      <div class="philosophy-copy">
        <p class="section-label">{home.philosophyKicker}</p>
        <h2 id="philosophy-title">{home.philosophyTitle}</h2>
        <p>{home.philosophyBody}</p>
      </div>

      <div class="principle-list">
        {home.principles.map((item, index) => (
          <article class="principle-row">
            <span>0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-closing shell" aria-labelledby="closing-title">
      <div>
        <p class="section-label">{home.closingKicker}</p>
        <h2 id="closing-title">{home.closingTitle}</h2>
        <p>{home.closingBody}</p>
      </div>
      <a class="button button-primary" href={localizedPath(locale, '/products')}>
        {home.closingCta}<span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</SiteLayout>

<style>
  .home-page {
    overflow: clip;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(480px, 1.12fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    min-height: 0;
    padding-block: clamp(3.6rem, 6vw, 6.4rem);
  }

  .hero-copy {
    max-width: 620px;
  }

  .home-hero h1 {
    margin: 0;
    font-size: clamp(3.4rem, 6vw, 6rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .home-hero h1 span,
  .home-hero h1 strong {
    display: block;
  }

  .home-hero h1 strong {
    color: #2182f3;
    font-weight: inherit;
    background: linear-gradient(104deg, #1f63d8 0%, #2489f6 48%, #48c7df 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    max-width: 590px;
    margin-block-start: 1.45rem;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.68;
  }

  .hero-actions,
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 1.8rem;
  }

  .trust-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
    margin-block-start: 1.5rem;
    color: var(--muted);
    font-size: 0.77rem;
    font-weight: 700;
  }

  .trust-line span {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .trust-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .trust-dot-1 { background: #2b72f6; }
  .trust-dot-2 { background: #42bdd8; }
  .trust-dot-3 { background: #e7a84e; }

  .founder-visual {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: clamp(390px, 39vw, 560px);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 40px;
    background:
      radial-gradient(circle at 70% 25%, rgba(83, 196, 222, 0.18), transparent 32%),
      radial-gradient(circle at 18% 88%, rgba(43, 114, 246, 0.09), transparent 28%),
      linear-gradient(145deg, #fbfdff, #eef6fa);
    box-shadow: 0 30px 90px rgba(28, 56, 92, 0.11);
  }

  .founder-glow {
    position: absolute;
    z-index: -1;
    width: 45%;
    aspect-ratio: 1;
    inset-block-start: 10%;
    inset-inline-end: 8%;
    border-radius: 50%;
    background: rgba(71, 196, 223, 0.16);
    filter: blur(45px);
  }

  .founder-visual img {
    position: absolute;
    inset-inline-end: -7%;
    inset-block-end: -1px;
    width: 118%;
    max-width: none;
    height: auto;
    object-fit: contain;
  }

  .founder-visual figcaption {
    position: absolute;
    z-index: 2;
    inset-inline-start: 1.15rem;
    inset-block-end: 1.15rem;
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 14px 38px rgba(27, 48, 75, 0.09);
    backdrop-filter: blur(12px);
  }

  .founder-visual figcaption strong {
    font-size: 0.82rem;
  }

  .founder-visual figcaption span {
    color: var(--muted);
    font-size: 0.66rem;
  }

  .home-product {
    position: relative;
    padding-block: clamp(4.8rem, 8vw, 7.5rem);
    border-block: 1px solid rgba(24, 41, 62, 0.08);
    background:
      radial-gradient(circle at 75% 20%, rgba(74, 196, 225, 0.16), transparent 32rem),
      radial-gradient(circle at 20% 80%, rgba(95, 114, 232, 0.08), transparent 28rem),
      #f5f9fc;
  }

  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(520px, 1.28fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .product-copy {
    max-width: 520px;
  }

  .product-copy h2,
  .workflow-heading h2,
  .philosophy-copy h2,
  .home-closing h2 {
    margin: 0;
    font-size: clamp(2.7rem, 4.9vw, 4.8rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .product-promise {
    margin-block-start: 1.1rem;
    color: #1f5fc9;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 780;
    line-height: 1.38;
  }

  .product-body {
    margin-block-start: 1rem;
    color: var(--muted);
    line-height: 1.72;
  }

  .quality-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin-block-start: 1.5rem;
    color: var(--ink-2);
    font-size: 0.78rem;
    font-weight: 740;
  }

  .quality-line span {
    position: relative;
    padding-inline-start: 0.9rem;
  }

  .quality-line span::before {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #35a8d7;
    content: "";
  }

  .device-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
    align-items: end;
    justify-content: center;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    min-height: 590px;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 38px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 28px 80px rgba(34, 64, 102, 0.11);
  }

  .stage-glow {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    inset-block-start: 2%;
    inset-inline-end: 0;
    border-radius: 50%;
    background: rgba(77, 190, 220, 0.16);
    filter: blur(60px);
  }

  .device {
    position: relative;
    z-index: 1;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(15, 37, 66, 0.08);
    border-radius: 31px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(23, 50, 84, 0.14);
  }

  .device img {
    width: 100%;
    height: auto;
  }

  .device-secondary {
    transform: translateY(26px) rotate(-1.2deg);
  }

  .device-main {
    transform: rotate(0.9deg);
  }

  .real-screen-label {
    position: absolute;
    z-index: 3;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    padding: 0.55rem 0.72rem;
    color: var(--ink-2);
    border: 1px solid rgba(24, 41, 62, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.68rem;
    font-weight: 800;
    box-shadow: 0 10px 24px rgba(25, 49, 80, 0.08);
  }

  .workflow-section {
    padding-block: clamp(5rem, 8vw, 8rem);
  }

  .workflow-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .workflow-heading > p {
    color: var(--muted);
    line-height: 1.72;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(330px, 0.68fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    margin-block-start: clamp(3rem, 5vw, 4.5rem);
  }

  .scan-visual {
    width: min(100%, 390px);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(20, 44, 75, 0.09);
    border-radius: 34px;
    background: #fff;
    box-shadow: 0 28px 70px rgba(27, 54, 88, 0.13);
  }

  .scan-visual img {
    width: 100%;
    height: auto;
  }

  .workflow-copy {
    border-block-start: 1px solid rgba(24, 41, 62, 0.11);
  }

  .workflow-fact {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    padding-block: 1.55rem;
    border-block-end: 1px solid rgba(24, 41, 62, 0.11);
  }

  .workflow-fact > span,
  .principle-row > span {
    color: #2c77e7;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .workflow-fact h3,
  .principle-row h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .workflow-fact p,
  .principle-row p {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.68;
  }

  .philosophy-section {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    margin-block: 0 clamp(0rem, 0vw, 0rem);
    padding: clamp(3rem, 5vw, 5rem);
    color: #eef6ff;
    border-radius: 38px;
    background:
      radial-gradient(circle at 90% 12%, rgba(68, 193, 224, 0.23), transparent 28rem),
      radial-gradient(circle at 5% 100%, rgba(102, 94, 218, 0.18), transparent 30rem),
      linear-gradient(145deg, #0f2138, #143458 68%, #174769);
    box-shadow: 0 32px 90px rgba(15, 36, 61, 0.16);
  }

  .philosophy-section .section-label {
    color: #74d2e7;
  }

  .philosophy-copy h2 {
    color: #fff;
  }

  .philosophy-copy > p:last-child {
    max-width: 580px;
    margin-block-start: 1.2rem;
    color: rgba(237, 245, 253, 0.72);
    line-height: 1.74;
  }

  .principle-list {
    border-block-start: 1px solid rgba(255, 255, 255, 0.15);
  }

  .principle-row {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 1rem;
    padding-block: 1.3rem;
    border-block-end: 1px solid rgba(255, 255, 255, 0.15);
  }

  .principle-row > span {
    color: #72d3e7;
  }

  .principle-row h3 {
    color: #fff;
  }

  .principle-row p {
    color: rgba(237, 245, 253, 0.68);
  }

  .home-closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(4.5rem, 7vw, 7rem);
  }

  .home-closing > div {
    max-width: 760px;
  }

  .home-closing > div > p:last-child {
    max-width: 650px;
    margin-block-start: 1rem;
    color: var(--muted);
    line-height: 1.72;
  }

  @media (max-width: 1080px) {
    .home-hero {
      grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
      gap: 2.5rem;
    }

    .product-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(440px, 1.2fr);
      gap: 3rem;
    }

    .device-stage {
      min-height: 520px;
    }
  }

  @media (max-width: 880px) {
    .home-hero,
    .product-grid,
    .workflow-grid,
    .philosophy-section {
      grid-template-columns: 1fr;
    }

    .home-hero {
      gap: 2.4rem;
      padding-block-start: 3.4rem;
    }

    .hero-copy,
    .product-copy {
      max-width: 680px;
    }

    .founder-visual {
      min-height: clamp(360px, 62vw, 510px);
    }

    .product-grid {
      gap: 2.8rem;
    }

    .device-stage {
      width: min(100%, 720px);
      min-height: 590px;
      margin-inline: auto;
    }

    .workflow-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .workflow-grid {
      gap: 2.6rem;
    }

    .workflow-copy {
      width: min(100%, 720px);
      margin-inline: auto;
    }

    .philosophy-section {
      gap: 2.2rem;
    }

    .home-closing {
      align-items: flex-start;
    }
  }

  @media (max-width: 620px) {
    .home-hero {
      gap: 1.8rem;
      padding-block: 2.8rem 3.8rem;
    }

    .home-hero h1 {
      font-size: clamp(3rem, 14vw, 4.25rem);
    }

    .hero-lead {
      font-size: 0.98rem;
    }

    .hero-actions,
    .product-actions {
      align-items: stretch;
    }

    .hero-actions .button,
    .product-actions .button {
      flex: 1 1 100%;
    }

    .product-actions .text-link {
      justify-content: center;
      min-height: 44px;
    }

    .founder-visual {
      min-height: 300px;
      border-radius: 28px;
    }

    .founder-visual img {
      width: 132%;
      inset-inline-end: -17%;
    }

    .founder-visual figcaption {
      inset-inline-start: 0.8rem;
      inset-block-end: 0.8rem;
      padding: 0.62rem 0.72rem;
      border-radius: 13px;
    }

    .home-product,
    .workflow-section {
      padding-block: 4rem;
    }

    .product-copy h2,
    .workflow-heading h2,
    .philosophy-copy h2,
    .home-closing h2 {
      font-size: clamp(2.45rem, 11vw, 3.5rem);
    }

    .quality-line {
      display: grid;
      gap: 0.6rem;
    }

    .device-stage {
      display: block;
      min-height: 0;
      padding: 1rem;
      border-radius: 28px;
    }

    .device-secondary {
      display: none;
    }

    .device-main {
      width: min(84%, 340px);
      margin-inline: auto;
      transform: none;
      border-radius: 25px;
    }

    .real-screen-label {
      inset-inline-start: 0.85rem;
      inset-block-end: 0.85rem;
    }

    .workflow-grid {
      margin-block-start: 2.2rem;
    }

    .scan-visual {
      width: min(84%, 330px);
      border-radius: 27px;
    }

    .workflow-fact,
    .principle-row {
      grid-template-columns: 42px 1fr;
      gap: 0.7rem;
    }

    .philosophy-section {
      padding: 2rem 1.4rem;
      border-radius: 28px;
    }

    .home-closing {
      flex-direction: column;
      align-items: stretch;
      padding-block: 4rem;
    }

    .home-closing .button {
      width: 100%;
    }
  }
</style>
